{{ 'component-image-with-text.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #shopify-section-{{ section.id }} {
    --image-with-text-content-max-width: {{ section.settings.content_max_width }}px;
  }

  .image-with-text-custom {
    display: flex;
    align-items: center;
    gap: 0;
    flex-direction: {% if section.settings.layout == 'text_first' %}row-reverse{% else %}row{% endif %};
    background: rgb(232 220 209);
    height: 503px;
  }

  .image-with-text-custom__content p,
  .image-with-text-custom__content h2 {
    color: #1C1C1C;
  }

  .image-with-text-custom__media {
    flex: 0 0 50%;
    width: 50%;
    height: 100%;
  }

  .image-with-text-custom__media picture {
    display: block;
    height: 100%;
  }

  .image-with-text-custom__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    vertical-align: bottom;
  }

  .image-with-text-custom__content {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    flex: 0 0 50%;
    width: 50%;
    height: 100%;
    margin: 0;
    padding: 0 clamp(48px, 5vw, 96px);
    text-align: {{ section.settings.desktop_content_alignment }};
  }

  /* Inner content wrapper - this gets the max-width constraint */
  .image-with-text-custom__content-inner {
    /* max-width: {{ section.settings.content_max_width }}px; */
    width: 100%;
    margin: 0;
  }

  /* Adjust inner wrapper alignment based on text alignment */
  .image-with-text-custom__content.text-left .image-with-text-custom__content-inner {
    margin-left: 0;
    margin-right: auto;
  }

  .image-with-text-custom__content.text-right .image-with-text-custom__content-inner {
    margin-left: auto;
    margin-right: 0;
  }

  .image-with-text-custom__content.text-center .image-with-text-custom__content-inner {
    margin-left: auto;
    margin-right: auto;
  }

  /* For the second content block without inner wrapper (add this to maintain consistency) */
  .image-with-text-custom__content:not(:has(.image-with-text-custom__content-inner)) > * {
    max-width: {{ section.settings.content_max_width }}px;
    margin-left: auto;
    margin-right: auto;
  }

  /* Override for the second layout where inner wrapper is missing */
  .image-with-text-custom__content.text-left:not(:has(.image-with-text-custom__content-inner)) > * {
    margin-left: 0;
    margin-right: auto;
  }

  .image-with-text-custom__content.text-right:not(:has(.image-with-text-custom__content-inner)) > * {
    margin-left: auto;
    margin-right: 0;
  }

  @media screen and (max-width: 749px) {
    .image-with-text-custom {
      flex-direction: column;
      gap: {{ section.settings.mobile_gap }}px;
      height: auto;
    }

    .image-with-text-custom__media,
    .image-with-text-custom__content {
      width: 100%;
      height: auto;
    }

    .image-with-text-custom__content {
      padding: 0 20px;
      text-align: {{ section.settings.mobile_content_alignment }};
    }

    .image-with-text-custom__media img {
      height: auto;
    }
    
    /* Reset margins on mobile for better responsiveness */
    .image-with-text-custom__content-inner,
    .image-with-text-custom__content:not(:has(.image-with-text-custom__content-inner)) > * {
      margin-left: auto;
      margin-right: auto;
      max-width: 100%;
    }
  }

  /* Typography styles */
  .image-with-text-custom__heading {
    font-size: {{ section.settings.heading_size_desktop }}px;
    line-height: 1.2;
    margin-bottom: {{ section.settings.heading_margin_bottom }}px;
  }

  .image-with-text-custom__subheading {
    font-size: {{ section.settings.subheading_size_desktop }}px;
    line-height: 1.3;
    margin-bottom: {{ section.settings.subheading_margin_bottom }}px;
    letter-spacing: 5px;
  }

  .image-with-text-custom__text {
    font-size: {{ section.settings.text_size_desktop }}px;
    line-height: 1.6;
    margin-bottom: {{ section.settings.text_margin_bottom }}px;
  }

  @media screen and (max-width: 749px) {
    .image-with-text-custom__heading {
      font-size: {{ section.settings.heading_size_mobile }}px;
    }

    .image-with-text-custom__subheading {
      font-size: {{ section.settings.subheading_size_mobile }}px;
    }

    .image-with-text-custom__text {
      font-size: {{ section.settings.text_size_mobile }}px;
    }
  }

  /* Button styles */
  .image-with-text-custom__button {
    display: inline-block;
    background-color: transparent;
    background-image:
      linear-gradient({{ section.settings.button_bg_color }}, {{ section.settings.button_bg_color }}),
      linear-gradient({{ section.settings.button_hover_bg_color }}, {{ section.settings.button_hover_bg_color }});
    background-repeat: no-repeat;
    background-size: 100% 100%, 0 100%;
    background-position: right top, left top;
    color: {{ section.settings.button_text_color }};
    padding: {{ section.settings.button_padding_top_bottom }}px {{ section.settings.button_padding_left_right }}px;
    border: {{ section.settings.button_border_width }}px solid {{ section.settings.button_border_color }};
    border-radius: {{ section.settings.button_border_radius }}px;
    font-size: {{ section.settings.button_font_size }}px;
    cursor: pointer;
    text-decoration: none;
    transition: color 0.3s ease, border-color 0.3s ease, background-size 0.4s ease;
  }

  .image-with-text-custom__button:hover {
    color: {{ section.settings.button_hover_text_color }};
    border-color: {{ section.settings.button_hover_border_color }};
    background-size: 0 100%, 100% 100%;
  }

  .py-0 {
    padding-top: 0;
    padding-bottom: 0;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .image-with-text-custom__content-inner {
      padding: 0px 10px 50px 20px;
    }
    #shopify-section-template--27147866276203__image_with_text_custom_eEkqF4 .image-with-text-custom__content-inner {
        text-align: center;
        padding: 0px 10px 10px 10px !important;
    }
  }

  
/* Between two widths */
@media screen and (min-width: 975px) and (max-width: 1300px) {
  .image-with-text-custom{
    gap: 0px !important;
  }
  .image-with-text-custom__heading {
    font-size: 36px !important;
    line-height: 1 !important;
    margin-bottom: 20px !important;
  }
}
@media screen and (min-width: 750px) and (max-width: 975px) {
  .image-with-text-custom{
    gap: 0 !important;
  }
  .image-with-text-custom__subheading {
    font-size: 16px !important;
    line-height: 1 !important;
    margin-bottom: 0px !important;
  }
  .image-with-text-custom__heading {
    font-size: 26px !important;
    line-height: 1 !important;
    margin-bottom: 15px !important;
    margin-top: 8px !important;
  }
  .image-with-text-custom__text {
    font-size: 13px !important;
    line-height: 1.3 !important;
    margin-bottom: 10px !important;
  }
}

{%- endstyle -%}

<div class="section-{{ section.id }}-padding color-scheme color-scheme--{{ section.settings.color_scheme }} py-0">
    <image-with-text class="image-with-text-custom">
      {%- if section.settings.layout == 'text_first' -%}
        <div class="image-with-text-custom__content prose sm:text-start">
            <div class="image-with-text-custom__content-inner" style="max-width: {{ section.settings.content_max_width }}px;">
            {%- for block in section.blocks -%}
                {% case block.type %}
                {%- when 'subheading' -%}
                    {% if block.settings.subheading != blank %}
                    <p class="image-with-text-custom__subheading h6" {{ block.shopify_attributes }}>
                        {{ block.settings.subheading }}
                    </p>
                    {% endif %}
                {%- when 'heading' -%}
                    {% if block.settings.heading != blank %}
                    <h2 class="image-with-text-custom__heading h1" {{ block.shopify_attributes }}>
                        {{ block.settings.heading }}
                    </h2>
                    {% endif %}
                {%- when 'text' -%}
                    {% if block.settings.text != blank %}
                    <div class="image-with-text-custom__text" {{ block.shopify_attributes }}>
                        {{ block.settings.text }}
                    </div>
                    {% endif %}
                {%- when 'button' -%}
                    {% if block.settings.button_label != blank %}
                    <button 
                        type="button" 
                        class="image-with-text-custom__button button"
                        {{ block.shopify_attributes }}
                        {% if block.settings.button_link != blank %}
                        onclick="window.location.href='{{ block.settings.button_link }}'"
                        {% endif %}
                    >
                        {{ block.settings.button_label | escape }}
                    </button>
                    {% endif %}
                {%- endcase -%}
            {%- endfor -%}
          </div>
        </div>
        <div class="image-with-text-custom__media">
          {%- if section.settings.image != blank -%}
            <picture>
              {{ section.settings.image | image_url: width: section.settings.image.width | image_tag: loading: 'lazy', reveal_on_scroll: 'true' }}
            </picture>
          {%- else -%}
            {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
      {%- else -%}
        <div class="image-with-text-custom__media">
          {%- if section.settings.image != blank -%}
            <picture>
              {{ section.settings.image | image_url: width: section.settings.image.width | image_tag: loading: 'lazy', reveal_on_scroll: 'true' }}
            </picture>
          {%- else -%}
            {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
        <div class="image-with-text-custom__content prose sm:text-start">
          {% comment %} style="max-width: {{ section.settings.content_max_width }}px;" {% endcomment %}
            <div class="image-with-text-custom__content-inner" >
                {%- for block in section.blocks -%}
                    {% case block.type %}
                    {%- when 'subheading' -%}
                        {% if block.settings.subheading != blank %}
                        <p class="image-with-text-custom__subheading h6" {{ block.shopify_attributes }}>
                            {{ block.settings.subheading }}
                        </p>
                        {% endif %}
                    {%- when 'heading' -%}
                        {% if block.settings.heading != blank %}
                        <h2 class="image-with-text-custom__heading h1" {{ block.shopify_attributes }}>
                            {{ block.settings.heading }}
                        </h2>
                        {% endif %}
                    {%- when 'text' -%}
                        {% if block.settings.text != blank %}
                        <div class="image-with-text-custom__text" {{ block.shopify_attributes }}>
                            {{ block.settings.text }}
                        </div>
                        {% endif %}
                    {%- when 'button' -%}
                        {% if block.settings.button_label != blank %}
                        <button 
                            type="button" 
                            class="image-with-text-custom__button button"
                            {{ block.shopify_attributes }}
                            {% if block.settings.button_link != blank %}
                            onclick="window.location.href='{{ block.settings.button_link }}'"
                            {% endif %}
                        >
                            {{ block.settings.button_label | escape }}
                        </button>
                        {% endif %}
                    {%- endcase -%}
                {%- endfor -%}
            </div>
        </div>
      {%- endif -%}
    </image-with-text>
</div>

{% schema %}
{
  "name": "image-with-text-custom",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "layout",
      "options": [
        {
          "value": "image_first",
          "label": "Image first"
        },
        {
          "value": "text_first",
          "label": "Text first"
        }
      ],
      "default": "image_first",
      "label": "Layout"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading size (desktop)",
      "default": 48
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 16,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading size (mobile)",
      "default": 32
    },
    {
      "type": "range",
      "id": "subheading_size_desktop",
      "min": 12,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Subheading size (desktop)",
      "default": 18
    },
    {
      "type": "range",
      "id": "subheading_size_mobile",
      "min": 10,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Subheading size (mobile)",
      "default": 14
    },
    {
      "type": "range",
      "id": "text_size_desktop",
      "min": 12,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Text size (desktop)",
      "default": 16
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Text size (mobile)",
      "default": 14
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "desktop_gap",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Desktop gap between image and text",
      "default": 50
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Mobile gap between image and text",
      "default": 30
    },
    {
      "type": "range",
      "id": "heading_margin_bottom",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Heading margin bottom",
      "default": 20
    },
    {
      "type": "range",
      "id": "subheading_margin_bottom",
      "min": 0,
      "max": 30,
      "step": 5,
      "unit": "px",
      "label": "Subheading margin bottom",
      "default": 10
    },
    {
      "type": "range",
      "id": "text_margin_bottom",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Text margin bottom",
      "default": 25
    },
    {
      "type": "range",
      "id": "content_max_width",
      "min": 300,
      "max": 800,
      "step": 10,
      "unit": "px",
      "label": "Content max width",
      "default": 430
    },
    {
      "type": "header",
      "content": "Button settings"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button background color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_border_color",
      "label": "Button border color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_hover_bg_color",
      "label": "Button hover background color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Button hover text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_hover_border_color",
      "label": "Button hover border color",
      "default": "#333333"
    },
    {
      "type": "range",
      "id": "button_font_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Button font size",
      "default": 14
    },
    {
      "type": "range",
      "id": "button_padding_top_bottom",
      "min": 6,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Button padding (top/bottom)",
      "default": 12
    },
    {
      "type": "range",
      "id": "button_padding_left_right",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Button padding (left/right)",
      "default": 30
    },
    {
      "type": "range",
      "id": "button_border_width",
      "min": 0,
      "max": 5,
      "step": 1,
      "unit": "px",
      "label": "Button border width",
      "default": 1
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Button border radius",
      "default": 0
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    },
    {
      "type": "select",
      "id": "desktop_content_alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left",
      "label": "Desktop content alignment"
    },
    {
      "type": "select",
      "id": "mobile_content_alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center",
      "label": "Mobile content alignment"
    }
  ],
  "blocks": [
    {
      "type": "subheading",
      "name": "Subheading",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading",
          "default": "THE"
        }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Heading",
          "default": "DINING edit"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Whether your aesthetic leans toward the warmth of mid-century textures or the cool precision of industrial marble, these pairings are designed to transform your dining space into an enduring sanctuary of conversation and taste.</p>"
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "SHOP NOW"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "image-with-text-custom",
      "blocks": [
        {
          "type": "subheading"
        },
        {
          "type": "heading"
        },
        {
          "type": "text"
        },
        {
          "type": "button"
        }
      ]
    }
  ]
}
{% endschema %}
