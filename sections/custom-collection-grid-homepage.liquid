{% schema %}
{
  "name": "Custom Collection Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SHOP BY ROOM"
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "ROOM NAME"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Custom Collection Grid"
    }
  ]
}
{% endschema %}

<style>
  .custom-collection-section {
    padding: 40px 20px;
  }

  .custom-collection-heading {
    text-align: center;
    margin-bottom: 30px;
  }

  .custom-collection-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0PX;
  }

  @media (min-width: 700px) {
    .custom-collection-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1150px) {
    .custom-collection-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .collection-card {
    position: relative;
    overflow: hidden;
    display: block;
  }

  .collection-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .collection-card:hover img {
    transform: scale(1.05);
  }

  .collection-card-content {
    position: absolute;
    bottom: 15px;
    left: 15px;
  }

  .collection-card-content button {
    border: 1px solid #000;
    background: transparent;
    padding: 8px 14px;
    font-size: 14px;
    cursor: pointer;
  }
</style>

<div class="custom-collection-section">
  <div class="custom-collection-heading">
    <h2>{{ section.settings.heading }}</h2>
  </div>

  <div class="custom-collection-grid">
    {% for block in section.blocks %}
      <a href="{{ block.settings.link }}" class="collection-card">
        {% if block.settings.image %}
          <img width="2752" height="1536" loading="lazy" sizes="(max-width: 699px) 100vw, (max-width: 1149px) 50vw, 25vw" src="{{ block.settings.image | image_url: width: 1200 }}" alt="{{ block.settings.title }}">
        {% endif %}

        <div class="collection-card-content">
          <button type="button">{{ block.settings.title }}</button>
        </div>
      </a>
    {% endfor %}
  </div>
</div>
