{% schema %}
{
  "name": "Custom Collection Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SHOP BY ROOM"
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "ROOM NAME"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Custom Collection Grid"
    }
  ]
}
{% endschema %}

<style>
  .custom-collection-section {
  padding: 40px 0px;
}

.custom-collection-heading {
  text-align: center;
  margin-bottom: 30px;
}

.custom-collection-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 0;
}

@media (min-width: 700px) {
  .custom-collection-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (min-width: 1150px) {
  .custom-collection-grid {
    grid-template-columns: repeat(4, 1fr);
  }
}

/* CARD */
.collection-card {
  position: relative;
  overflow: hidden;
  display: block;
}

/* IMAGE */
.collection-card img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* EXACT ZOOM EFFECT */
@media screen and (pointer: fine) and (prefers-reduced-motion: no-preference) {
  .collection-card img {
    transform-origin: center;
    transition: transform 8s cubic-bezier(.25, .46, .45, .94);
  }

  .collection-card:hover img {
    transform: scale(1.1);
  }
}

/* CONTENT OVER IMAGE */
.collection-card-content {
  position: absolute;
  bottom: 20px;
  left: 20px;
}

/* BUTTON BASE (matches your theme style) */
.collection-card-content button {
  position: relative;
  color: white;
  border: 1px solid white;
  padding: 10px 18px;
  font-size: 14px;
  background: transparent;
  cursor: pointer;

  background-image: 
    linear-gradient(transparent, transparent),
    linear-gradient(white, white);

  background-repeat: no-repeat;
  background-size: 100% 100%, 0 100%;
  background-position: left, right;

  transition: 
    color 0.3s ease,
    background-size 0.4s ease,
    border-color 0.3s ease;
}

/* BUTTON HOVER EFFECT */
@media screen and (pointer: fine) and (prefers-reduced-motion: no-preference) {
  .collection-card-content button:hover {
    color: black;
    background-size: 0 100%, 100% 100%;
    border-color: white;
  }
}
  
</style>

<div class="custom-collection-section">
  <div class="custom-collection-heading">
    <h2>{{ section.settings.heading }}</h2>
  </div>

  <div class="custom-collection-grid">
    {% for block in section.blocks %}
      <a href="{{ block.settings.link }}" class="collection-card">
        {% if block.settings.image %}
          <img width="2752" height="1536" loading="lazy" sizes="(max-width: 699px) 100vw, (max-width: 1149px) 50vw, 25vw" src="{{ block.settings.image | image_url: width: 1200 }}" alt="{{ block.settings.title }}">
        {% endif %}

        <div class="collection-card-content">
          <button type="button">{{ block.settings.title }}</button>
        </div>
      </a>
    {% endfor %}
  </div>
</div>
