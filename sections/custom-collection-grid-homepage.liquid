{% schema %}
{
  "name": "Custom Collection Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SHOP BY ROOM"
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "ROOM NAME"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Custom Collection Grid"
    }
  ]
}
{% endschema %}

<style>
  .custom-collection-section {
    padding: 8rem 0 0;
    background: white;
  }

  .custom-collection-heading {
    text-align: center;
  }

  .custom-collection-heading > h1 {
    letter-spacing: 0.13em;
    margin-bottom: 65px;
    color: black;
  }

  .custom-collection-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.2rem;
    {% comment %} max-width: 144rem; {% endcomment %}
    margin: 0 auto;
  }

  @media (min-width: 700px) {
    .custom-collection-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1150px) {
    .custom-collection-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 0;
      height: 100vh;
    }
  }

  .collection-card {
    position: relative;
    overflow: hidden;
    display: block;
    min-height: 28rem;
    background: #f5f5f5;
  }

  .collection-card img {
    width: 100%;
    height: 100%;
    min-height: 28rem;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    display: block;
  }

  @media screen and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .collection-card img {
      transform-origin: center;
      transition: transform 8s cubic-bezier(.25, .46, .45, .94);
    }

    .collection-card:hover img {
      transform: scale(1.1);
    }
  }

  .collection-card-content {
    position: absolute;
    bottom: 4rem;
    left: 4rem;
    right: 1.6rem;
  }

  .collection-card-content button {
    position: relative;
    color: white;
    border: 1px solid white;
    padding: 1rem 1.8rem;
    font-size: 1.3rem;
    letter-spacing: 0.12em;
    background: transparent;
    cursor: pointer;
    font-family: cabin, sans-serif;

    background-image:
      linear-gradient(transparent, transparent),
      linear-gradient(white, white);

    background-repeat: no-repeat;
    background-size: 100% 100%, 0 100%;
    background-position: right top, left top;

    transition:
      color 0.3s ease,
      background-size 0.4s ease,
      border-color 0.3s ease;
  }

  @media screen and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .collection-card-content button:hover {
      color: black;
      background-size: 0 100%, 100% 100%;
      border-color: white;
    }
  }

  @media (max-width: 699px) {
    .custom-collection-heading h2 {
      font-size: clamp(2.2rem, 7vw, 3.2rem);
    }

    .collection-card {
      min-height: 22rem;
    }

    .collection-card img {
      min-height: 22rem;
    }
  }
</style>

<div class="custom-collection-section">
  <div class="custom-collection-heading">
    <h1>{{ section.settings.heading }}</h1>
  </div>

  <div class="custom-collection-grid">
    {% for block in section.blocks %}
      <a href="{{ block.settings.link }}" class="collection-card">
        {% if block.settings.image %}
          <img width="2752" height="1536" loading="lazy" sizes="(max-width: 699px) 100vw, (max-width: 1149px) 50vw, 25vw" src="{{ block.settings.image | image_url: width: 1200 }}" alt="{{ block.settings.title }}">
        {% endif %}

        <div class="collection-card-content">
          <button type="button">{{ block.settings.title }}</button>
        </div>
      </a>
    {% endfor %}
  </div>
</div>
