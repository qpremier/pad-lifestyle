{% comment %} 
  Dynamic Media Grid Section - 70% Image / 30% Video
{% endcomment %}

{%- style -%}
#shopify-section-{{ section.id }} {
  --media-grid-row-height: 100vh;
  --media-grid-gap: 0rem;
  --container-gutter: 0;
  --section-vertical-spacing-override: 0;
}

/* Remove spacing */
#shopify-section-{{ section.id }} .section-spacing {
  margin: 0 !important;
  padding: 0 !important;
}

#shopify-section-{{ section.id }} .container {
  padding: 0 !important;
  max-width: 100% !important;
  margin: 0 !important;
  width: 100% !important;
}

#shopify-section-{{ section.id }} .section-stack {
  gap: 0 !important;
  display: block !important;
}

/* Grid */
.media-grid {
  display: grid !important;
  grid-template-columns: 70% 30% !important;
  gap: 0 !important;
  width: 100% !important;
}

.media-grid__item {
  margin: 0 !important;
  padding: 0 !important;
}

.media-grid__item > * {
  height: 100%;
  display: block;
}

/* Wrapper */
.content-over-media {
  display: grid !important;
  position: relative !important;
  overflow: hidden !important;
  height: 100% !important;
  width: 100% !important;
}

/* Media */
.content-over-media img,
.content-over-media video {
  width: 100% !important;
  height: 100% !important;
  object-fit: cover !important;
  object-position: center !important;
  display: block !important;
}

/* =========================
   HOVER ZOOM EFFECT
   ========================= */
@media screen and (pointer: fine) and (prefers-reduced-motion: no-preference) {
  
  #shopify-section-{{ section.id }} .group:hover .group-hover\:zoom {
    transform: scale(1.2);
  }

  #shopify-section-{{ section.id }} .zoom-image {
    transform-origin: center;
    transition: transform 8s cubic-bezier(.25, .46, .45, .94);
  }
}

/* Mobile */
@media screen and (max-width: 749px) {
  .media-grid {
    grid-template-columns: 1fr !important;
  }
  .content-over-media img, .content-over-media video {
    min-height: 70vh;
  }

  #shopify-section-{{ section.id }} {
    --media-grid-row-height: auto;
  }
}
{%- endstyle -%}


<div class="section-spacing color-scheme color-scheme--{{ section.settings.color_scheme }}">
  <div class="container">
    <div class="section-stack">
      <div class="media-grid">

        {%- for block in section.blocks -%}
          <div class="media-grid__item" {{ block.shopify_attributes }}>
            
            <div class="content-over-media group">

              {%- if block.type == 'image' -%}
                {%- if block.settings.image != blank -%}
                  
                  <img 
                    class="zoom-image group-hover:zoom"
                    src="{{ block.settings.image | img_url: 'master' }}" 
                    alt="{{ block.settings.image.alt | default: 'Media image' }}" 
                    loading="lazy"
                    height=""
                    width=""
                  >

                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-image' }}
                {%- endif -%}

              {%- elsif block.type == 'video' -%}
                {%- if block.settings.video_url != blank -%}

                  <!-- VIDEO -->
                  <video autoplay muted loop playsinline>
                    <source src="{{ block.settings.video_url }}" type="video/mp4">
                  </video>

                {%- else -%}
                  <div style="background:#eee; height:100%; display:flex; align-items:center; justify-content:center;">
                    Add video URL
                  </div>
                {%- endif -%}
              {%- endif -%}

            </div>
          </div>
        {%- endfor -%}

      </div>
    </div>
  </div>
</div>


{% schema %}
{
  "name": "Media Grid 70/30",
  "tag": "section",
  "class": "shopify-section--media-grid",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image (70%)",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    },
    {
      "type": "video",
      "name": "Video (30%)",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "video_url",
          "label": "Video URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Media Grid 70/30",
      "blocks": [
        { "type": "image" },
        { "type": "video" }
      ]
    }
  ]
}
{% endschema %}
