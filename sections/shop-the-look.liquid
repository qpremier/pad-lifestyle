{% liquid
  assign section_title = section.settings.heading
  assign section_subheading = section.settings.subheading
  assign cta_label = section.settings.button_label | default: 'View product'
  assign image_alt = section.settings.image.alt | default: section_title
%}

<section
  id="shopify-section-{{ section.id }}"
  class="shop-the-look-points color-{{ section.settings.color_scheme }} bg-white"
  data-section-id="{{ section.id }}"
>
  <div class="shop-the-look-points__inner">
    {% if section_title != blank or section_subheading != blank %}
      <div class="shop-the-look-points__header">
        {% if section_subheading != blank %}
          <p class="shop-the-look-points__eyebrow">{{ section_subheading }}</p>
        {% endif %}
        {% if section_title != blank %}
          <h2 class="shop-the-look-points__title">{{ section_title }}</h2>
        {% endif %}
      </div>
    {% endif %}

    <div class="shop-the-look-points__layout">
      <div class="shop-the-look-points__media">
        <div class="shop-the-look-points__image-wrap">
          {% if section.settings.image != blank %}
            {{
              section.settings.image
              | image_url: width: 2000
              | image_tag:
                loading: 'lazy',
                widths: '500, 700, 900, 1100, 1400, 1700, 2000',
                class: 'shop-the-look-points__image',
                alt: image_alt
            }}
          {% else %}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'shop-the-look-points__image shop-the-look-points__image--placeholder' }}
          {% endif %}

          <div class="shop-the-look-points__hotspots" role="tablist" aria-label="{{ section_title | default: 'Shop the look' | escape }}">
            {% for block in section.blocks %}
              {% assign product = block.settings.product %}
              {% assign hotspot_label = block.settings.label | default: product.title | default: 'Hotspot' %}
              <button
                class="shop-the-look-points__hotspot{% if forloop.first %} is-active{% endif %}"
                type="button"
                role="tab"
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                aria-controls="ShopTheLookPanel-{{ section.id }}-{{ block.id }}"
                id="ShopTheLookTab-{{ section.id }}-{{ block.id }}"
                data-target="{{ block.id }}"
                style="--hotspot-top: {{ block.settings.top }}%; --hotspot-left: {{ block.settings.left }}%;"
                {{ block.shopify_attributes }}
              >
                <span class="shop-the-look-points__hotspot-dot"></span>
                <span class="visually-hidden">{{ hotspot_label }}</span>
              </button>
            {% endfor %}
          </div>
        </div>

        {% if section.blocks.size > 0 %}
          <button type="button" class="button shop-the-look-points__view-products">
            View products
          </button>
        {% endif %}
      </div>

      <button
        type="button"
        class="shop-the-look-points__drawer-overlay"
        aria-label="Close Shop the look products"
      ></button>

      <div class="shop-the-look-points__products">
        <div class="shop-the-look-points__drawer-header">
          <p class="shop-the-look-points__drawer-title">Shop the look</p>
          <button type="button" class="shop-the-look-points__drawer-close" aria-label="Close Shop the look products">
            <svg aria-hidden="true" focusable="false" fill="none" width="14" class="icon icon-close" viewBox="0 0 16 16">
              <path d="m1 1 14 14M1 15 15 1" stroke="currentColor" stroke-width="1.5"></path>
            </svg>
          </button>
        </div>

        {% if section.blocks.size > 0 %}
          {% for block in section.blocks %}
            {% assign product = block.settings.product %}
            <article
              id="ShopTheLookPanel-{{ section.id }}-{{ block.id }}"
              class="shop-the-look-points__product{% if forloop.first %} is-active{% endif %}"
              role="tabpanel"
              aria-labelledby="ShopTheLookTab-{{ section.id }}-{{ block.id }}"
              {% unless forloop.first %}hidden{% endunless %}
            >
              {% if product != blank %}
                <div class="shop-the-look-points__product-card">
                  <a href="{{ product.url }}" class="shop-the-look-points__product-media">
                    {% if product.featured_image != blank %}
                      {{
                        product.featured_image
                        | image_url: width: 900
                        | image_tag:
                          loading: 'lazy',
                          widths: '300, 450, 600, 750, 900',
                          class: 'shop-the-look-points__product-image',
                          alt: product.featured_image.alt | default: product.title
                      }}
                    {% else %}
                      {{ 'product-1' | placeholder_svg_tag: 'shop-the-look-points__product-image shop-the-look-points__product-image--placeholder' }}
                    {% endif %}
                  </a>

                  <div class="shop-the-look-points__product-content">
                    {% if block.settings.label != blank %}
                      <p class="shop-the-look-points__product-kicker">{{ block.settings.label }}</p>
                    {% endif %}

                    <h3 class="shop-the-look-points__product-title">
                      <a href="{{ product.url }}">{{ product.title }}</a>
                    </h3>

                    <div class="shop-the-look-points__product-price">
                      {% if product.compare_at_price > product.price %}
                        <span class="shop-the-look-points__product-price--sale">{{ product.price | money }}</span>
                        <span class="shop-the-look-points__product-price--compare">{{ product.compare_at_price | money }}</span>
                      {% else %}
                        <span>{{ product.price | money }}</span>
                      {% endif %}
                    </div>

                    {% if block.settings.description != blank %}
                      <div class="shop-the-look-points__product-description rte">
                        {{ block.settings.description }}
                      </div>
                    {% endif %}

                    <a href="{{ product.url }}" class="button shop-the-look-points__button">
                      {{ cta_label }}
                    </a>
                  </div>
                </div>
              {% else %}
                <div class="shop-the-look-points__empty">
                  <p>Choose a product for this hotspot in the theme editor.</p>
                </div>
              {% endif %}
            </article>
          {% endfor %}
        {% else %}
          <div class="shop-the-look-points__empty">
            <p>Add hotspot blocks and assign products to build this section.</p>
          </div>
        {% endif %}
      </div>
    </div>
  </div>

  <style>
    .bg-white{
      background: white;
    }
    #shopify-section-{{ section.id }} {
      background: #fff !important;
    }
    .container .section-header {
      margin-inline: 0;
    }
    .justify-self-center {
      justify-self: center;
    }
    .text-center {
      text-align: center;
    }
    html.shop-the-look-points-drawer-open {
      overflow: hidden;
    }

    #shopify-section-{{ section.id }} {
      --shop-look-bg: {{ section.settings.card_background.red }}, {{ section.settings.card_background.green }}, {{ section.settings.card_background.blue }};
      --shop-look-accent: {{ section.settings.hotspot_color.red }}, {{ section.settings.hotspot_color.green }}, {{ section.settings.hotspot_color.blue }};
      --shop-look-text: {{ section.settings.text_color.red }}, {{ section.settings.text_color.green }}, {{ section.settings.text_color.blue }};
      --shop-look-border: rgba({{ section.settings.text_color.red }}, {{ section.settings.text_color.green }}, {{ section.settings.text_color.blue }}, 0.12);
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    #shopify-section-{{ section.id }} .shop-the-look-points__inner {
      color: rgb(var(--shop-look-text));
      padding-bottom: 100px;
    }

    #shopify-section-{{ section.id }} .shop-the-look-points__header {
      text-align: center;
      max-width: 52rem;
      margin: 0 auto 6.5rem;
    }

    #shopify-section-{{ section.id }} .shop-the-look-points__eyebrow {
      margin: 0 0 0.75rem;
      font-size: 1.2rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      opacity: 0.7;
    }

    #shopify-section-{{ section.id }} .shop-the-look-points__title {
      margin: 0;
      color: black;
      letter-spacing: 0.23em;
      font-size: 4rem;
      text-transform: uppercase;
    }

    @media screen and (min-width: 768px) {
      #shopify-section-{{ section.id }} .shop-the-look-points__title {
        font-size: 4rem;
      }
    }
    @media screen and (max-width: 768px) {
      #shopify-section-{{ section.id }} .shop-the-look-points__title {
        font-size: 2.5rem;
      }
    }

    #shopify-section-{{ section.id }} .shop-the-look-points__layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(320px, 1fr);
      gap: 2rem;
      align-items: start;
    }

    #shopify-section-{{ section.id }} .shop-the-look-points__image-wrap {
      position: relative;
      overflow: hidden;
      border-radius: {{ section.settings.image_radius }}px;
      background: rgba(var(--shop-look-bg), 0.35);
    }

    #shopify-section-{{ section.id }} .shop-the-look-points__image,
    #shopify-section-{{ section.id }} .shop-the-look-points__image--placeholder {
      display: block;
      width: 100%;
      height: auto;
      max-height: 510px;
    }

    #shopify-section-{{ section.id }} .shop-the-look-points__hotspots {
      position: absolute;
      inset: 0;
    }

    #shopify-section-{{ section.id }} .shop-the-look-points__hotspot {
      position: absolute;
      top: var(--hotspot-top);
      left: var(--hotspot-left);
      transform: translate(-50%, -50%);
      width: 2.6rem;
      height: 2.6rem;
      border: 0;
      border-radius: 999px;
      background: transparent;
      padding: 0;
      cursor: pointer;
      z-index: 1;
    }

    #shopify-section-{{ section.id }} .shop-the-look-points__hotspot::before,
    #shopify-section-{{ section.id }} .shop-the-look-points__hotspot::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: 999px;
    }

    #shopify-section-{{ section.id }} .shop-the-look-points__hotspot::before {
      background: rgba(var(--shop-look-accent), 0.18);
      animation: shop-the-look-pulse-{{ section.id }} 2s ease-out infinite;
    }

    #shopify-section-{{ section.id }} .shop-the-look-points__hotspot::after {
      inset: 0.35rem;
      background: rgb(var(--shop-look-accent));
      border: 0.2rem solid #fff;
      box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.08);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    #shopify-section-{{ section.id }} .shop-the-look-points__hotspot.is-active::after,
    #shopify-section-{{ section.id }} .shop-the-look-points__hotspot:hover::after,
    #shopify-section-{{ section.id }} .shop-the-look-points__hotspot:focus-visible::after {
      transform: scale(1.08);
      box-shadow: 0 0 0 4px rgba(var(--shop-look-accent), 0.18);
    }

    #shopify-section-{{ section.id }} .shop-the-look-points__products {
      position: sticky;
      top: 2rem;
    }

    #shopify-section-{{ section.id }} .shop-the-look-points__view-products {
      display: none;
    }

    #shopify-section-{{ section.id }} .shop-the-look-points__drawer-overlay,
    #shopify-section-{{ section.id }} .shop-the-look-points__drawer-header {
      display: none;
    }

    #shopify-section-{{ section.id }} .shop-the-look-points__product {
      display: none;
    }

    #shopify-section-{{ section.id }} .shop-the-look-points__product.is-active {
      display: block;
    }

    #shopify-section-{{ section.id }} .shop-the-look-points__empty {
      background: rgb(var(--shop-look-bg));
      border: 1px solid var(--shop-look-border);
      border-radius: {{ section.settings.card_radius }}px;
      overflow: hidden;
    }

    #shopify-section-{{ section.id }} .shop-the-look-points__product-media {
      display: block;
      background: rgba(0, 0, 0, 0.03);
    }

    #shopify-section-{{ section.id }} .shop-the-look-points__product-image,
    #shopify-section-{{ section.id }} .shop-the-look-points__product-image--placeholder {
      display: block;
      width: 100%;
      aspect-ratio: 1 / 1;
      object-fit: cover;
      max-height: 275px;
      min-height: 275px;
    }

    #shopify-section-{{ section.id }} .shop-the-look-points__product-content {
      padding: 1.8rem;
      text-align: center;
    }

    #shopify-section-{{ section.id }} .shop-the-look-points__product-kicker {
      margin: 0 0 0.75rem;
      font-size: 1.2rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      opacity: 0.65;
    }

    #shopify-section-{{ section.id }} .shop-the-look-points__product-title {
      margin: 0 0 0.85rem;
      font-size: clamp(2rem, 2.2vw, 2.6rem);
      line-height: 1.1;
    }

    #shopify-section-{{ section.id }} .shop-the-look-points__product-title a {
      color: black;
      text-decoration: none;
    }

    #shopify-section-{{ section.id }} .shop-the-look-points__product-price {
      display: flex;
      gap: 0.75rem;
      align-items: center;
      margin-bottom: 1rem;
      font-size: 1.8rem;
      font-weight: 600;
      justify-content: center;
    }

    #shopify-section-{{ section.id }} .shop-the-look-points__product-price--compare {
      opacity: 0.55;
      text-decoration: line-through;
      font-size: 1.5rem;
      font-weight: 400;
    }

    #shopify-section-{{ section.id }} .shop-the-look-points__product-description {
      margin-bottom: 1.4rem;
      opacity: 0.8;
    }

    #shopify-section-{{ section.id }} .shop-the-look-points__button {
      width: 100%;
      justify-content: center;
    }

    #shopify-section-{{ section.id }} .shop-the-look-points__empty {
      padding: 2rem;
    }

    @keyframes shop-the-look-pulse-{{ section.id }} {
      0% {
        transform: scale(0.75);
        opacity: 0.9;
      }
      70% {
        transform: scale(1.3);
        opacity: 0;
      }
      100% {
        transform: scale(1.3);
        opacity: 0;
      }
    }

    @media screen and (max-width: 989px) {
      #shopify-section-{{ section.id }} .shop-the-look-points__layout {
        grid-template-columns: 1fr;
      }

      #shopify-section-{{ section.id }} .shop-the-look-points__products {
        position: static;
      }
    }

    @media screen and (max-width: 768px) {
      #shopify-section-{{ section.id }} .shop-the-look-points__inner {
        padding-bottom: 4rem;
      }

      #shopify-section-{{ section.id }} .shop-the-look-points__layout {
        border: 0;
        margin-left: 15px;
        margin-right: 15px;
      }

      #shopify-section-{{ section.id }} .shop-the-look-points__view-products {
        display: inline-flex;
        width: 100%;
        margin-top: 15px;
        justify-content: center;
      }

      #shopify-section-{{ section.id }} .shop-the-look-points__drawer-overlay {
        display: block;
        position: fixed;
        inset: 0;
        border: 0;
        padding: 0;
        background: rgba(0, 0, 0, 0.44);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.24s ease;
        z-index: 70;
      }

      #shopify-section-{{ section.id }}.is-drawer-open .shop-the-look-points__drawer-overlay {
        opacity: 1;
        pointer-events: auto;
      }

      #shopify-section-{{ section.id }} .shop-the-look-points__products {
        position: fixed;
        inset: auto 0 0;
        top: auto;
        z-index: 71;
        max-height: min(82vh, 62rem);
        overflow-y: auto;
        padding: 0 1.6rem 1.6rem;
        background: rgb(var(--shop-look-bg));
        border-radius: 2rem 2rem 0 0;
        box-shadow: 0 -1.2rem 4rem rgba(0, 0, 0, 0.22);
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transform: translateY(100%);
        transition: transform 0.28s ease, opacity 0.28s ease, visibility 0.28s ease;
      }

      #shopify-section-{{ section.id }}.is-drawer-open .shop-the-look-points__products {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
        transform: translateY(0);
      }

      #shopify-section-{{ section.id }} .shop-the-look-points__drawer-header {
        position: sticky;
        top: 0;
        z-index: 1;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 1.4rem 0 1rem;
        background: rgb(var(--shop-look-bg));
      }

      #shopify-section-{{ section.id }} .shop-the-look-points__drawer-header::before {
        content: '';
        position: absolute;
        top: 0.6rem;
        left: 50%;
        width: 4.4rem;
        height: 0.4rem;
        border-radius: 999px;
        background: rgba(var(--shop-look-text), 0.22);
        transform: translateX(-50%);
      }

      #shopify-section-{{ section.id }} .shop-the-look-points__drawer-title {
        margin: 0;
        padding-top: 1rem;
        color: rgb(var(--shop-look-text));
        font-size: 1.6rem;
        font-weight: 600;
      }

      #shopify-section-{{ section.id }} .shop-the-look-points__drawer-close {
        display: grid;
        place-items: center;
        width: 4rem;
        height: 4rem;
        margin-top: 0.5rem;
        border: 1px solid var(--shop-look-border);
        border-radius: 999px;
        background: transparent;
        color: rgb(var(--shop-look-text));
        cursor: pointer;
      }

      #shopify-section-{{ section.id }} .shop-the-look-points__product-card,
      #shopify-section-{{ section.id }} .shop-the-look-points__empty {
        border-radius: 1.2rem;
      }

      #shopify-section-{{ section.id }} .shop-the-look-points__product-card {
        display: grid;
        grid-template-columns: minmax(10rem, 36%) minmax(0, 1fr);
      }

      #shopify-section-{{ section.id }} .shop-the-look-points__product-image,
      #shopify-section-{{ section.id }} .shop-the-look-points__product-image--placeholder {
        height: 100%;
        min-height: 18rem;
        max-height: none;
      }

      #shopify-section-{{ section.id }} .shop-the-look-points__product-content {
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 1.4rem;
      }

      #shopify-section-{{ section.id }} .shop-the-look-points__product-title {
        font-size: 1.8rem;
      }

      #shopify-section-{{ section.id }} .shop-the-look-points__product-price {
        font-size: 1.5rem;
      }
    }
  </style>

  <script>
    (() => {
      const sectionEl = document.querySelector('#shopify-section-{{ section.id }}');
      if (!sectionEl || sectionEl.dataset.initialized === 'true') return;
      sectionEl.dataset.initialized = 'true';

      const tabs = Array.from(sectionEl.querySelectorAll('.shop-the-look-points__hotspot'));
      const panels = Array.from(sectionEl.querySelectorAll('.shop-the-look-points__product'));
      const drawerOverlay = sectionEl.querySelector('.shop-the-look-points__drawer-overlay');
      const drawerClose = sectionEl.querySelector('.shop-the-look-points__drawer-close');
      const viewProductsButton = sectionEl.querySelector('.shop-the-look-points__view-products');
      const mobileMedia = window.matchMedia('(max-width: 768px)');

      if (!tabs.length || !panels.length) return;

      const openDrawer = () => {
        if (!mobileMedia.matches) return;

        sectionEl.classList.add('is-drawer-open');
        document.documentElement.classList.add('shop-the-look-points-drawer-open');
      };

      const closeDrawer = () => {
        sectionEl.classList.remove('is-drawer-open');

        if (!document.querySelector('.shop-the-look-points.is-drawer-open')) {
          document.documentElement.classList.remove('shop-the-look-points-drawer-open');
        }
      };

      const activate = (targetId, shouldOpenDrawer = false) => {
        tabs.forEach((tab) => {
          const isActive = tab.dataset.target === targetId;
          tab.classList.toggle('is-active', isActive);
          tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });

        panels.forEach((panel) => {
          const isActive = panel.id === `ShopTheLookPanel-{{ section.id }}-${targetId}`;
          panel.classList.toggle('is-active', isActive);
          panel.hidden = !isActive;
        });

        if (shouldOpenDrawer) {
          openDrawer();
        }
      };

      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => activate(tab.dataset.target, true));

        tab.addEventListener('keydown', (event) => {
          const currentIndex = tabs.indexOf(tab);
          let nextIndex = null;

          if (event.key === 'ArrowRight' || event.key === 'ArrowDown') {
            nextIndex = (currentIndex + 1) % tabs.length;
          }

          if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') {
            nextIndex = (currentIndex - 1 + tabs.length) % tabs.length;
          }

          if (event.key === 'Home') {
            nextIndex = 0;
          }

          if (event.key === 'End') {
            nextIndex = tabs.length - 1;
          }

          if (nextIndex === null) return;

          event.preventDefault();
          tabs[nextIndex].focus();
          activate(tabs[nextIndex].dataset.target, mobileMedia.matches);
        });
      });

      drawerOverlay?.addEventListener('click', closeDrawer);
      drawerClose?.addEventListener('click', closeDrawer);
      viewProductsButton?.addEventListener('click', () => activate(tabs[0].dataset.target, true));

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          closeDrawer();
        }
      });

      mobileMedia.addEventListener('change', (event) => {
        if (!event.matches) {
          closeDrawer();
        }
      });

      activate(tabs[0].dataset.target);
    })();
  </script>
</section>

{% schema %}
{
  "name": "Shop the look points",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Interactive look"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop the look"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Main image"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "View product"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Product card background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "hotspot_color",
      "label": "Hotspot color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Product card corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
