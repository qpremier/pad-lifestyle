{{ 'component-newsletter.css' | asset_url | stylesheet_tag }}
{{ 'newsletter-section.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* Dynamic background styles - applied to the section itself */
  #shopify-section-{{ section.id }}.section {
    {% if section.settings.background_type == 'color' %}
      background-color: {{ section.settings.background_color }};
    {% elsif section.settings.background_type == 'gradient' %}
      background: {{ section.settings.background_gradient }};
    {% elsif section.settings.background_type == 'image' and section.settings.background_image != blank %}
      background-image: url('{{ section.settings.background_image | img_url: 'master' }}');
      background-size: {{ section.settings.background_image_size }};
      background-position: {{ section.settings.background_image_position }};
      background-repeat: {{ section.settings.background_image_repeat }};
      background-attachment: {{ section.settings.background_image_attachment }};
    {% endif %}
  }

  /* Make the inner wrapper transparent so the section background shows through */
  #shopify-section-{{ section.id }} .newsletter__wrapper {
    background-color: transparent !important;
    {% if section.settings.background_type == 'image' and section.settings.overlay_opacity > 0 %}
      position: relative;
      z-index: 1;
    {% endif %}
  }

  /* Add an overlay for better text readability on background images */
  {% if section.settings.background_type == 'image' and section.settings.overlay_opacity > 0 %}
    #shopify-section-{{ section.id }}.section {
      position: relative;
    }
    #shopify-section-{{ section.id }}.section::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-color: {{ section.settings.overlay_color }};
      opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
      pointer-events: none;
      z-index: 0;
    }
    #shopify-section-{{ section.id }} .newsletter__wrapper {
      position: relative;
      z-index: 1;
    }
  {% endif %}

  .qq-asim-color{
    background: #64642a;
  }

  .sec-qqabc{
    letter-spacing: 0.20em;
  }
  .first-qqabc {
    letter-spacing: 0.16em;
    font-size: 18px;
  }

  #shopify-section-{{ section.id }} .newsletter-form__field-wrapper {
    max-width: 54rem;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .newsletter-form__controls {
    align-items: stretch;
    display: flex;
    gap: 1rem;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .newsletter-form__controls .field {
    flex: 1 1 auto;
  }

  #shopify-section-{{ section.id }} .newsletter-form__controls .field__input {
    padding-right: 1.5rem;
  }

  #shopify-section-{{ section.id }} .newsletter-form__submit {
    align-items: center;
    display: inline-flex;
    flex: 0 0 auto;
    justify-content: center;
    min-width: 20rem;
    white-space: nowrap;
    text-transform: uppercase;
    color: #6e6a2f;
    letter-spacing: 0.13em;
    background-color: transparent;
    background-image:
      linear-gradient(#feead5, #feead5),
      linear-gradient(#6e6a2f, #6e6a2f);
    background-repeat: no-repeat;
    background-size: 100% 100%, 0 100%;
    background-position: right top, left top;
    transition: color 0.3s ease, background-size 0.4s ease;
  }

  #shopify-section-{{ section.id }} .newsletter-form__submit:after {
    box-shadow: none !important;
  }

  #shopify-section-{{ section.id }} .newsletter-form__submit:hover {
    color: #feead5;
    background-size: 0 100%, 100% 100%;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .newsletter-form__controls {
      gap: 0.8rem;
    }

    #shopify-section-{{ section.id }} .newsletter-form__submit {
      min-width: 11.5rem;
      padding-left: 1.6rem;
      padding-right: 1.6rem;
    }
  }

  @media screen and (min-width: 300px) and (max-width: 992px) {
    .newsletter-form {
      align-items: center !important;
      margin: 0 auto;
      max-width: 36rem !important;
    }
    .footer-block-custom .footer-block__heading, .newsletter-description > p, .footer-about-description {
      text-align: center !important;
    }
    .footer-block-image-wrapper {
      margin: 0 auto;
    }
    .footer-block__details-content-custom {
      justify-items: center;
      text-align: center;
    }
    .social-media{
      justify-content: center;
    }
    .footer__aside p {
      text-align: center !important;
    }
    .footer__content-bottom-wrapper {
      justify-content: center !important;
    }
  }

{%- endstyle -%}

<div class="newsletter center {% if section.settings.full_width == false %}newsletter--narrow page-width{% endif %}">
  <div class="newsletter__wrapper gradient content-container isolate{% if section.settings.full_width %} content-container--full-width{% endif %} section-{{ section.id }}-padding">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when '@app' -%}
          {% render block %}
        {%- when 'heading' -%}
          <h3
            class="inline-richtext first-qqabc {{ block.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {{ block.shopify_attributes }}
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: {{ forloop.index }};"
            {% endif %}
          >
            {{ block.settings.heading }}
          </h3>
        {%- when 'extra_heading' -%}
          <h3
            class="inline-richtext sec-qqabc {{ block.settings.extra_heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {{ block.shopify_attributes }}
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: {{ forloop.index }};"
            {% endif %}
          >
            {{ block.settings.extra_heading }}
          </h3>
        {%- when 'paragraph' -%}
          <div
            class="newsletter__subheading rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {{ block.shopify_attributes }}
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: {{ forloop.index }};"
            {% endif %}
          >
            {{ block.settings.text }}
          </div>
        {%- when 'email_form' -%}
          <div {{ block.shopify_attributes }}>
            {% form 'customer', class: 'newsletter-form' %}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <div
                class="newsletter-form__field-wrapper{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                {% if settings.animations_reveal_on_scroll %}
                  data-cascade
                  style="--animation-order: {{ forloop.index }};"
                {% endif %}
              >
                <div class="newsletter-form__controls">
                  <div class="field">
                    <input
                      id="NewsletterForm--{{ section.id }}"
                      type="email"
                      name="contact[email]"
                      class="field__input qq-asim-color"
                      value="{{ form.email }}"
                      aria-required="true"
                      autocorrect="off"
                      autocapitalize="off"
                      autocomplete="email"
                      {% if form.errors %}
                        autofocus
                        aria-invalid="true"
                        aria-describedby="Newsletter-error--{{ section.id }}"
                      {% elsif form.posted_successfully? %}
                        aria-describedby="Newsletter-success--{{ section.id }}"
                      {% endif %}
                      placeholder="{{ 'newsletter.label' | t }}"
                      required
                    >
                    <label class="field__label" for="NewsletterForm--{{ section.id }}">
                      {{ 'newsletter.label' | t }}
                    </label>
                  </div>
                  <button
                    type="submit"
                    class="newsletter-form__submit button"
                    name="commit"
                    id="Subscribe"
                    aria-label="{{ 'newsletter.button_label' | t }}"
                  >
                    {{- 'newsletter.button_label' | t -}}
                  </button>
                </div>
                {%- if form.errors -%}
                  <small class="newsletter-form__message form__message" id="Newsletter-error--{{ section.id }}">
                    <span class="svg-wrapper">
                      {{- 'icon-error.svg' | inline_asset_content -}}
                    </span>
                    {{- form.errors.translated_fields.email | capitalize }}
                    {{ form.errors.messages.email -}}
                  </small>
                {%- endif -%}
              </div>
              {%- if form.posted_successfully? -%}
                <h3
                  class="newsletter-form__message newsletter-form__message--success form__message"
                  id="Newsletter-success--{{ section.id }}"
                  tabindex="-1"
                  autofocus
                >
                  <span class="svg-wrapper">
                    {{- 'icon-success.svg' | inline_asset_content -}}
                  </span>
                  {{- 'newsletter.success' | t }}
                </h3>
              {%- endif -%}
            {% endform %}
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Newsletter with BG",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.newsletter.settings.paragraph.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1",
      "info": "This affects text and button colors. The background will be transparent to show your dynamic background below."
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "default": true,
      "label": "t:sections.newsletter.settings.full_width.label"
    },
    {
      "type": "header",
      "content": "Dynamic Background Settings"
    },
    {
      "type": "select",
      "id": "background_type",
      "label": "Background Type",
      "options": [
        {
          "value": "none",
          "label": "None (Transparent)"
        },
        {
          "value": "color",
          "label": "Solid Color"
        },
        {
          "value": "gradient",
          "label": "Gradient"
        },
        {
          "value": "image",
          "label": "Image"
        }
      ],
      "default": "none"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#F3F4F6"
    },
    {
      "type": "text",
      "id": "background_gradient",
      "label": "Background Gradient",
      "default": "linear-gradient(135deg, #667eea 0%, #764ba2 100%)",
      "info": "Example: linear-gradient(45deg, #ff0000, #0000ff)"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "select",
      "id": "background_image_size",
      "label": "Image Size",
      "options": [
        {
          "value": "auto",
          "label": "Auto"
        },
        {
          "value": "cover",
          "label": "Cover"
        },
        {
          "value": "contain",
          "label": "Contain"
        }
      ],
      "default": "cover"
    },
    {
      "type": "select",
      "id": "background_image_position",
      "label": "Image Position",
      "options": [
        {
          "value": "center center",
          "label": "Center"
        },
        {
          "value": "top left",
          "label": "Top Left"
        },
        {
          "value": "top center",
          "label": "Top Center"
        },
        {
          "value": "top right",
          "label": "Top Right"
        },
        {
          "value": "center left",
          "label": "Center Left"
        },
        {
          "value": "center right",
          "label": "Center Right"
        },
        {
          "value": "bottom left",
          "label": "Bottom Left"
        },
        {
          "value": "bottom center",
          "label": "Bottom Center"
        },
        {
          "value": "bottom right",
          "label": "Bottom Right"
        }
      ],
      "default": "center center"
    },
    {
      "type": "select",
      "id": "background_image_repeat",
      "label": "Image Repeat",
      "options": [
        {
          "value": "no-repeat",
          "label": "No Repeat"
        },
        {
          "value": "repeat",
          "label": "Repeat"
        },
        {
          "value": "repeat-x",
          "label": "Repeat X"
        },
        {
          "value": "repeat-y",
          "label": "Repeat Y"
        }
      ],
      "default": "no-repeat"
    },
    {
      "type": "select",
      "id": "background_image_attachment",
      "label": "Image Attachment",
      "options": [
        {
          "value": "scroll",
          "label": "Scroll"
        },
        {
          "value": "fixed",
          "label": "Fixed (Parallax)"
        }
      ],
      "default": "scroll"
    },
    {
      "type": "header",
      "content": "Overlay Settings (for background images)"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Overlay Opacity",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Main Heading",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "Subscribe to our newsletter",
          "label": "Heading Text"
        },
        {
          "type": "select",
          "id": "heading_size",
          "options": [
            {
              "value": "h2",
              "label": "Small"
            },
            {
              "value": "h1",
              "label": "Medium"
            },
            {
              "value": "h0",
              "label": "Large"
            },
            {
              "value": "hxl",
              "label": "Extra Large"
            },
            {
              "value": "hxxl",
              "label": "Extra Extra Large"
            }
          ],
          "default": "h1",
          "label": "Heading Size"
        }
      ]
    },
    {
      "type": "extra_heading",
      "name": "Extra Heading",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "extra_heading",
          "default": "Get exclusive updates",
          "label": "Extra Heading Text"
        },
        {
          "type": "select",
          "id": "extra_heading_size",
          "options": [
            {
              "value": "h2",
              "label": "Small"
            },
            {
              "value": "h1",
              "label": "Medium"
            },
            {
              "value": "h0",
              "label": "Large"
            },
            {
              "value": "hxl",
              "label": "Extra Large"
            },
            {
              "value": "hxxl",
              "label": "Extra Extra Large"
            }
          ],
          "default": "h2",
          "label": "Extra Heading Size"
        }
      ]
    },
    {
      "type": "paragraph",
      "name": "t:sections.newsletter.blocks.paragraph.name",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "default": "t:sections.newsletter.blocks.paragraph.settings.paragraph.default",
          "label": "t:sections.newsletter.blocks.paragraph.settings.paragraph.label"
        }
      ]
    },
    {
      "type": "email_form",
      "name": "t:sections.newsletter.blocks.email_form.name",
      "limit": 1
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Newsletter with Dynamic BG",
      "blocks": [
        {
          "type": "heading"
        },
        {
          "type": "extra_heading"
        },
        {
          "type": "paragraph"
        },
        {
          "type": "email_form"
        }
      ]
    }
  ]
}
{% endschema %}
