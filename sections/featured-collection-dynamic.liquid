{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{% assign collection = section.settings.collection %}

{% if collection != blank %}

{% liquid
  assign is_slider_mode = false
  if section.settings.display_mode == 'slider'
    assign is_slider_mode = true
  endif

  assign products_to_display = section.settings.total_products | plus: 0
  assign products_to_display = products_to_display | at_most: collection.products_count
  assign products_per_row_desktop = section.settings.products_per_row | plus: 0
  assign products_per_row_desktop = products_per_row_desktop | at_most: products_to_display
  assign products_per_row_tablet = products_per_row_desktop | at_most: 3
  assign products_per_row_mobile = products_per_row_desktop | at_most: 2
%}

<section id="shopify-section-{{ section.id }}" class="shopify-section shopify-section--featured-collections bg-white top-margin-q8q">

  <style>
    /* ================================
        BASE GRID SETTINGS (MOBILE FIRST)
    ================================= */
    #shopify-section-{{ section.id }} {
        --product-list-items-per-row: 2;
        --product-list-horizontal-spacing-factor: 1;
        --product-list-vertical-spacing-factor: 1;
    }

    
    @media screen and (min-width: 768px) {
        #shopify-section-{{ section.id }}.top-margin-q8q {
          padding-top: 10rem;
          padding-bottom: 10rem;
        }
    }
    @media screen and (max-width: 768px) {
        #shopify-section-{{ section.id }}.top-margin-q8q {
          padding-top: 5rem;
          padding-bottom: 5rem;
        }
    }

    /* ================================
        TABLET (≥700px) → 3 ITEMS
    ================================= */
    @media screen and (min-width: 700px) {
        #shopify-section-{{ section.id }} {
        --product-list-items-per-row: 3;
        }
    }

    /* ================================
        SMALL DESKTOP (≥1000px) → 4 ITEMS
    ================================= */
    @media screen and (min-width: 1000px) {
        #shopify-section-{{ section.id }} {
        --product-list-items-per-row: 4;
        }
    }

    /* ================================
        LARGE DESKTOP (≥1150px) → 6 ITEMS
    ================================= */
    @media screen and (min-width: 1150px) {
        #shopify-section-{{ section.id }} {
        --product-list-items-per-row: 6;
        }
    }

    #shopify-section-{{ section.id }} .py-5{
        padding-top: 5rem;
        padding-bottom: 5rem;
    }

    #shopify-section-{{ section.id }} .section-heading-q{
        color: black;
        letter-spacing: 0.2em;
        margin-top: 10px;
    }

    @media screen and (min-width: 768px) {
        #shopify-section-{{ section.id }} .section-heading-q{
          font-size: 41px;
        }
    }
    @media screen and (max-width: 768px) {
        #shopify-section-{{ section.id }} .section-heading-q{
          font-size: 20px;
        }
    }
    
    #shopify-section-{{ section.id }} .section-stack {
        gap: 5rem;
        grid-auto-columns: minmax(0, 1fr);
        display: grid;
    }

    #shopify-section-{{ section.id }}.bg-white{
        background: white;
    }

    #shopify-section-{{ section.id }} .container{
        margin-left: 48px;
        margin-right: 48px;
    }

    /* ================================
        OPTIONAL: PRODUCT CARD CLEANUP
    ================================= */
    #shopify-section-{{ section.id }} .product-card__figure {
        position: relative;
    }

    #shopify-section-{{ section.id }} .product-card__media {
        display: grid;
        justify-content: center;
    }

    #shopify-section-{{ section.id }} .product-card {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 1.25rem;
        position: relative;
        align-content: start;
        scroll-snap-align: start;
    }

    #shopify-section-{{ section.id }} .product-card__info {
        display: grid;
        gap: 0.75rem;
        text-align: center;
        justify-items: center;
        align-content: start;
    }

    #shopify-section-{{ section.id }} a.product-title.h6{
        text-decoration: none !important;
        font-weight: 400;
        font-size: 16px;
        letter-spacing: 0.13em;
        font-family: Montserrat, sans-serif;
        text-transform: uppercase;
        color: black;
        margin: 0;
    }

    #shopify-section-{{ section.id }} .text-subdued {
        color: rgb(28 28 28 / .65);
        font-size: 1.8rem;
    }

    #shopify-section-{{ section.id }} .v-stack {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        align-content: start;
    }

    #shopify-section-{{ section.id }} .gap-1 { gap: 0.25rem; }
    #shopify-section-{{ section.id }} .gap-2 { gap: 0.5rem; }
    #shopify-section-{{ section.id }} .gap-4 { gap: 1rem; }
    @media screen and (min-width: 700px) {
        #shopify-section-{{ section.id }} .sm\:gap-5 {
            gap: 1.25rem;
        }
    }

    #shopify-section-{{ section.id }} .justify-items-center {
        justify-items: center;
    }
    #shopify-section-{{ section.id }} .justify-self-center {
        justify-self: center;
    }
    #shopify-section-{{ section.id }} .text-center {
        text-align: center;
    }
    #shopify-section-{{ section.id }} .featured-collection-dynamic__product-grid {
        --featured-collection-dynamic-grid-columns: {{ products_per_row_mobile }};
        display: grid;
        align-items: start;
        row-gap: clamp(2rem, 3vw, 3rem);
        column-gap: clamp(1rem, 2vw, 3rem);
        grid-template-columns: repeat(var(--featured-collection-dynamic-grid-columns), minmax(0, 1fr));
    }

    #shopify-section-{{ section.id }} .small-heading-css{
        color: #1C1C1C;
        font-size: 18px;
        letter-spacing: 0.38em;
        line-height: 1.7;
        text-transform: uppercase;
        font-weight: 400;
        margin: 0;
    }

    #shopify-section-{{ section.id }} .featured-collection-dynamic__slider {
      display: block;
      position: relative;
      width: 100%;
      overflow: visible;
    }

    #shopify-section-{{ section.id }} .featured-collection-dynamic__slider-list {
      --featured-collection-dynamic-slider-gap: clamp(1rem, 2vw, 3rem);
      --featured-collection-dynamic-slider-columns: {{ products_per_row_mobile }};
      align-items: stretch;
      column-gap: 0;
      display: flex !important;
      flex-wrap: nowrap !important;
      gap: var(--featured-collection-dynamic-slider-gap);
      grid-template-columns: none !important;
      overflow-x: auto;
      padding: 0;
      width: 100%;
    }

    #shopify-section-{{ section.id }} .featured-collection-dynamic__slide {
      flex: 0 0 calc((100% - ((var(--featured-collection-dynamic-slider-columns) - 1) * var(--featured-collection-dynamic-slider-gap))) / var(--featured-collection-dynamic-slider-columns));
      max-width: calc((100% - ((var(--featured-collection-dynamic-slider-columns) - 1) * var(--featured-collection-dynamic-slider-gap))) / var(--featured-collection-dynamic-slider-columns));
      min-width: calc((100% - ((var(--featured-collection-dynamic-slider-columns) - 1) * var(--featured-collection-dynamic-slider-gap))) / var(--featured-collection-dynamic-slider-columns));
      scroll-snap-align: start;
      width: calc((100% - ((var(--featured-collection-dynamic-slider-columns) - 1) * var(--featured-collection-dynamic-slider-gap))) / var(--featured-collection-dynamic-slider-columns));
    }

    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} .featured-collection-dynamic__product-grid {
        --featured-collection-dynamic-grid-columns: {{ products_per_row_tablet }};
      }

      #shopify-section-{{ section.id }} .featured-collection-dynamic__slider-list {
        --featured-collection-dynamic-slider-columns: {{ products_per_row_tablet }};
      }
    }

    @media screen and (min-width: 990px) {
      #shopify-section-{{ section.id }} .featured-collection-dynamic__product-grid {
        --featured-collection-dynamic-grid-columns: {{ products_per_row_desktop }};
      }

      #shopify-section-{{ section.id }} .featured-collection-dynamic__slider-list {
        --featured-collection-dynamic-slider-columns: {{ products_per_row_desktop }};
      }
    }

    #shopify-section-{{ section.id }} .featured-collection-dynamic__slider .featured-collection-dynamic__slider-buttons {
      display: flex !important;
      inset: 50% 0 auto;
      justify-content: space-between;
      pointer-events: none;
      position: absolute;
      transform: translateY(-50%);
      width: 100%;
      z-index: 2;
    }

    #shopify-section-{{ section.id }} .featured-collection-dynamic__slider .featured-collection-dynamic__slider-buttons .slider-button {
      align-items: center;
      background: rgba(255, 255, 255, 0.95);
      border: 0.1rem solid rgba(28, 28, 28, 0.08);
      border-radius: 999px;
      box-shadow: 0 0.4rem 1.4rem rgba(0, 0, 0, 0.08);
      display: flex;
      height: 4.4rem;
      justify-content: center;
      pointer-events: auto;
      width: 4.4rem;
    }

    #shopify-section-{{ section.id }} .featured-collection-dynamic__slider .featured-collection-dynamic__slider-buttons .slider-button--prev {
      transform: translateX(-2.2rem);
    }

    #shopify-section-{{ section.id }} .featured-collection-dynamic__slider .featured-collection-dynamic__slider-buttons .slider-button--next {
      transform: translateX(2.2rem);
    }

    @media screen and (max-width: 749px) {
      #shopify-section-{{ section.id }} .container{
        margin-left: 2rem;
        margin-right: 2rem;
      }

      #shopify-section-{{ section.id }} .featured-collection-dynamic__slider .featured-collection-dynamic__slider-buttons .slider-button--prev {
        transform: translateX(-0.8rem);
      }

      #shopify-section-{{ section.id }} .featured-collection-dynamic__slider .featured-collection-dynamic__slider-buttons .slider-button--next {
        transform: translateX(0.8rem);
      }
    }
    .slider-button .icon {
      height: .6rem;
      color: black;
    }
    </style>

  <div class="section-spacing color-scheme color-scheme--scheme-2">
    <div class="container">

      <div class="section-stack">

        <!-- Heading -->
        <div class="v-stack justify-self-center gap-4 text-center sm:gap-5">
          <p class="h6 text-center small-heading-css">
            {{ section.settings.subheading }}
          </p>

          <h2 class="h2 section-heading-q">
            {{ collection.title }}
          </h2>
        </div>

        <!-- Products -->
        {% if is_slider_mode %}
          <slider-component class="featured-collection-dynamic__slider">
            <product-list
              id="Slider-{{ section.id }}"
              class="featured-collection-dynamic__slider-list slider slider--everywhere"
              aria-label="{{ collection.title | escape }}"
            >
              {% for product in collection.products limit: products_to_display %}
                <div id="Slide-{{ section.id }}-{{ forloop.index }}" class="featured-collection-dynamic__slide slider__slide">
                  <product-card class="product-card">

                    <div class="product-card__figure">
                      <a href="{{ product.url }}" class="product-card__media">

                        {% if product.featured_image %}
                          <img
                            src="{{ product.featured_image | image_url: width: 600 }}"
                            alt="{{ product.title }}"
                            class="product-card__image"
                            loading="lazy"
                            width="169"
                            height="169"
                          >
                        {% else %}
                          {{ 'product-1' | placeholder_svg_tag }}
                        {% endif %}

                      </a>
                    </div>

                    <div class="product-card__info empty:hidden">

                      <div class="v-stack justify-items-center gap-1">

                        <a href="{{ product.url }}" class="product-title h6">
                          {{ product.title }}
                        </a>

                        <price-list class="price-list">
                          <sale-price class="h6 text-subdued">
                            {{ product.price | money }}
                          </sale-price>
                        </price-list>

                      </div>

                    </div>

                  </product-card>
                </div>
              {% endfor %}
            </product-list>

            {% if products_to_display > 1 %}
              <div class="slider-buttons featured-collection-dynamic__slider-buttons">
                <button
                  type="button"
                  class="slider-button slider-button--prev"
                  name="previous"
                  aria-label="{{ 'general.slider.previous_slide' | t }}"
                  aria-controls="Slider-{{ section.id }}"
                >
                  <span class="svg-wrapper">
                    {{- 'icon-caret.svg' | inline_asset_content -}}
                  </span>
                </button>
                <div class="slider-counter caption visually-hidden">
                  <span class="slider-counter--current">1</span>
                  <span aria-hidden="true"> / </span>
                  <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
                  <span class="slider-counter--total">{{ products_to_display }}</span>
                </div>
                <button
                  type="button"
                  class="slider-button slider-button--next"
                  name="next"
                  aria-label="{{ 'general.slider.next_slide' | t }}"
                  aria-controls="Slider-{{ section.id }}"
                >
                  <span class="svg-wrapper">
                    {{- 'icon-caret.svg' | inline_asset_content -}}
                  </span>
                </button>
              </div>
            {% endif %}
          </slider-component>
        {% else %}
          <product-list class="featured-collection-dynamic__product-grid justify-center">

            {% for product in collection.products limit: products_to_display %}
              <product-card class="product-card">

                <div class="product-card__figure">
                  <a href="{{ product.url }}" class="product-card__media">

                    {% if product.featured_image %}
                      <img
                        src="{{ product.featured_image | image_url: width: 600 }}"
                        alt="{{ product.title }}"
                        class="product-card__image"
                        loading="lazy"
                        width="169"
                        height="169"
                      >
                    {% else %}
                      {{ 'product-1' | placeholder_svg_tag }}
                    {% endif %}

                  </a>
                </div>

                <div class="product-card__info empty:hidden">

                  <div class="v-stack justify-items-center gap-1">

                    <a href="{{ product.url }}" class="product-title h6">
                      {{ product.title }}
                    </a>

                    <price-list class="price-list">
                      <sale-price class="h6 text-subdued">
                        {{ product.price | money }}
                      </sale-price>
                    </price-list>

                  </div>

                </div>

              </product-card>
            {% endfor %}

          </product-list>
        {% endif %}

          <!-- View All Button -->
          <div class="justify-self-center">
            <a class="button" href="{{ collection.url }}">
              {{ section.settings.button_text }}
            </a>
          </div>

      </div>

    </div>
  </div>

</section>

{% endif %}

{% schema %}
{
  "name": "Featured Collection (QG)",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Select collection"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Featured collection"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "View all"
    },
    {
      "type": "select",
      "id": "display_mode",
      "label": "Display mode",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "slider",
          "label": "Slider"
        }
      ],
      "default": "grid"
    },
    {
      "type": "range",
      "id": "products_per_row",
      "label": "Products per row",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "total_products",
      "label": "Total products to show",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "Featured Collection (Dynamic)"
    }
  ]
}
{% endschema %}
