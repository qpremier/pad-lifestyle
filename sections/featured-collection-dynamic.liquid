{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{% assign collection = section.settings.collection %}

{% if collection != blank %}

{% liquid
  assign is_slider_mode = false
  if section.settings.display_mode == 'slider'
    assign is_slider_mode = true
  endif
%}

<section id="shopify-section-{{ section.id }}" class="shopify-section shopify-section--featured-collections bg-white top-margin-q8q">

  <style>
    /* ================================
        BASE GRID SETTINGS (MOBILE FIRST)
    ================================= */
    #shopify-section-{{ section.id }} {
        --product-list-items-per-row: 2;
        --product-list-horizontal-spacing-factor: 1;
        --product-list-vertical-spacing-factor: 1;
    }

    .top-margin-q8q {
      padding-top: 10rem;
      padding-bottom: 10rem;
    }

    /* ================================
        TABLET (≥700px) → 3 ITEMS
    ================================= */
    @media screen and (min-width: 700px) {
        #shopify-section-{{ section.id }} {
        --product-list-items-per-row: 3;
        }
    }

    /* ================================
        SMALL DESKTOP (≥1000px) → 4 ITEMS
    ================================= */
    @media screen and (min-width: 1000px) {
        #shopify-section-{{ section.id }} {
        --product-list-items-per-row: 4;
        }
    }

    /* ================================
        LARGE DESKTOP (≥1150px) → 6 ITEMS
    ================================= */
    @media screen and (min-width: 1150px) {
        #shopify-section-{{ section.id }} {
        --product-list-items-per-row: 6;
        }
    }

    .py-5{
        padding-top: 5rem;
        padding-bottom: 5rem;
    }

    .section-heading-q{
        font-size: 41px;
        color: black;
        letter-spacing: 0.2em;
        margin-top: 10px;
    }
    
    .section-stack {
        gap: 5rem;
        grid-auto-columns: minmax(0, 1fr);
        display: grid;
    }

    .bg-white{
        background: white;
    }

    .container{
        margin-left: 48px;
        margin-right: 48px;
    }

    /* ================================
        OPTIONAL: PRODUCT CARD CLEANUP
    ================================= */
    .product-card__figure {
        position: relative;
    }

    .product-card__media {
        display: grid;
        justify-content: center;
    }

    .product-card {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 1.25rem;
        position: relative;
        align-content: start;
        scroll-snap-align: start;
    }

    .product-card__info {
        display: grid;
        gap: 0.75rem;
        text-align: center;
        justify-items: center;
        align-content: start;
    }

    a.product-title.h6{
        text-decoration: none !important;
        font-weight: 400;
        font-size: 16px;
        letter-spacing: 0.13em;
        font-family: Montserrat, sans-serif;
        text-transform: uppercase;
        color: black;
        margin: 0;
    }

    .text-subdued {
        color: rgb(28 28 28 / .65);
        font-size: 1.8rem;
    }

    .v-stack {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        align-content: start;
    }

    .gap-1 { gap: 0.25rem; }
    .gap-2 { gap: 0.5rem; }
    .gap-4 { gap: 1rem; }
    @media screen and (min-width: 700px) {
        .sm:gap-5 {
            gap: 1.25rem;
        }
    }

    .justify-items-center {
        justify-items: center;
    }
    .justify-self-center {
        justify-self: center;
    }
    .text-center {
        text-align: center;
    }
    .product-list {
        display: grid;
        align-items: start;
        row-gap: clamp(2rem, 3vw, 3rem);
        column-gap: clamp(1rem, 2vw, 3rem);
        {% comment %} grid-template-columns: repeat(6, minmax(0, 1fr)); {% endcomment %}
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 160px), 1fr));
    }

    .small-heading-css{
        color: #1C1C1C;
        font-size: 18px;
        letter-spacing: 0.38em;
        line-height: 1.7;
        text-transform: uppercase;
        font-weight: 400;
        margin: 0;
    }

    .featured-collection-dynamic__slider {
      display: block;
      width: 100%;
    }

    .featured-collection-dynamic__slider-list {
      column-gap: clamp(1rem, 2vw, 3rem);
      display: flex;
    }

    .featured-collection-dynamic__slide {
      min-width: calc(50% - 0.5rem);
      scroll-snap-align: start;
    }

    @media screen and (min-width: 700px) {
      .featured-collection-dynamic__slide {
        min-width: calc(33.333% - 0.84rem);
      }
    }

    @media screen and (min-width: 1000px) {
      .featured-collection-dynamic__slide {
        min-width: calc(25% - 1rem);
      }
    }

    @media screen and (min-width: 1150px) {
      .featured-collection-dynamic__slide {
        min-width: calc(16.666% - 1.1rem);
      }
    }

    .featured-collection-dynamic__slider + .slider-buttons {
      margin-top: 3rem;
      justify-content: center;
    }
    </style>

  <div class="section-spacing color-scheme color-scheme--scheme-2">
    <div class="container">

      <div class="section-stack">

        <!-- Heading -->
        <div class="v-stack justify-self-center gap-4 text-center sm:gap-5">
          <p class="h6 text-center small-heading-css">
            {{ section.settings.subheading }}
          </p>

          <h2 class="h2 section-heading-q">
            {{ collection.title }}
          </h2>
        </div>

        <!-- Products -->
        {% if is_slider_mode %}
          {% paginate collection.products by 1000 %}
            <slider-component class="featured-collection-dynamic__slider">
              <product-list
                id="Slider-{{ section.id }}"
                class="product-list featured-collection-dynamic__slider-list slider slider--everywhere"
                aria-label="{{ collection.title | escape }}"
              >
                {% for product in collection.products %}
                  <div class="featured-collection-dynamic__slide slider__slide">
                    <product-card class="product-card">

                      <div class="product-card__figure">
                        <a href="{{ product.url }}" class="product-card__media">

                          {% if product.featured_image %}
                            <img
                              src="{{ product.featured_image | image_url: width: 600 }}"
                              alt="{{ product.title }}"
                              class="product-card__image"
                              loading="lazy"
                              width="169"
                              height="169"
                            >
                          {% else %}
                            {{ 'product-1' | placeholder_svg_tag }}
                          {% endif %}

                        </a>
                      </div>

                      <div class="product-card__info empty:hidden">

                        <div class="v-stack justify-items-center gap-1">

                          <a href="{{ product.url }}" class="product-title h6">
                            {{ product.title }}
                          </a>

                          <price-list class="price-list">
                            <sale-price class="h6 text-subdued">
                              {{ product.price | money }}
                            </sale-price>
                          </price-list>

                        </div>

                      </div>

                    </product-card>
                  </div>
                {% endfor %}
              </product-list>

              {% if collection.products_count > 1 %}
                <div class="slider-buttons">
                  <button
                    type="button"
                    class="slider-button slider-button--prev"
                    name="previous"
                    aria-label="{{ 'general.slider.previous_slide' | t }}"
                    aria-controls="Slider-{{ section.id }}"
                  >
                    <span class="svg-wrapper">
                      {{- 'icon-caret.svg' | inline_asset_content -}}
                    </span>
                  </button>
                  <div class="slider-counter caption">
                    <span class="slider-counter--current">1</span>
                    <span aria-hidden="true"> / </span>
                    <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
                    <span class="slider-counter--total">{{ collection.products_count }}</span>
                  </div>
                  <button
                    type="button"
                    class="slider-button slider-button--next"
                    name="next"
                    aria-label="{{ 'general.slider.next_slide' | t }}"
                    aria-controls="Slider-{{ section.id }}"
                  >
                    <span class="svg-wrapper">
                      {{- 'icon-caret.svg' | inline_asset_content -}}
                    </span>
                  </button>
                </div>
              {% endif %}
            </slider-component>
          {% endpaginate %}
        {% else %}
          <product-list class="product-list justify-center">

            {% for product in collection.products limit: section.settings.limit %}
              <product-card class="product-card">

                <div class="product-card__figure">
                  <a href="{{ product.url }}" class="product-card__media">

                    {% if product.featured_image %}
                      <img
                        src="{{ product.featured_image | image_url: width: 600 }}"
                        alt="{{ product.title }}"
                        class="product-card__image"
                        loading="lazy"
                        width="169"
                        height="169"
                      >
                    {% else %}
                      {{ 'product-1' | placeholder_svg_tag }}
                    {% endif %}

                  </a>
                </div>

                <div class="product-card__info empty:hidden">

                  <div class="v-stack justify-items-center gap-1">

                    <a href="{{ product.url }}" class="product-title h6">
                      {{ product.title }}
                    </a>

                    <price-list class="price-list">
                      <sale-price class="h6 text-subdued">
                        {{ product.price | money }}
                      </sale-price>
                    </price-list>

                  </div>

                </div>

              </product-card>
            {% endfor %}

          </product-list>
        {% endif %}

          <!-- View All Button -->
          <div class="justify-self-center">
            <a class="button" href="{{ collection.url }}">
              {{ section.settings.button_text }}
            </a>
          </div>

      </div>

    </div>
  </div>

</section>

{% endif %}

{% schema %}
{
  "name": "Featured Collection (QG)",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Select collection"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Featured collection"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "View all"
    },
    {
      "type": "select",
      "id": "display_mode",
      "label": "Display mode",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "slider",
          "label": "Slider"
        }
      ],
      "default": "grid"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products to show",
      "min": 6,
      "max": 24,
      "step": 6,
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "Featured Collection (Dynamic)"
    }
  ]
}
{% endschema %}
