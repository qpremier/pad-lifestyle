{% assign collection = section.settings.collection %}

{% if collection != blank %}

<section id="shopify-section-{{ section.id }}" class="shopify-section shopify-section--featured-collections">

  <style>
    /* ================================
        BASE GRID SETTINGS (MOBILE FIRST)
    ================================= */
    #shopify-section-{{ section.id }} {
        --product-list-items-per-row: 2;
        --product-list-horizontal-spacing-factor: 1;
        --product-list-vertical-spacing-factor: 1;
    }

    /* ================================
        TABLET (≥700px) → 3 ITEMS
    ================================= */
    @media screen and (min-width: 700px) {
        #shopify-section-{{ section.id }} {
        --product-list-items-per-row: 3;
        }
    }

    /* ================================
        SMALL DESKTOP (≥1000px) → 4 ITEMS
    ================================= */
    @media screen and (min-width: 1000px) {
        #shopify-section-{{ section.id }} {
        --product-list-items-per-row: 4;
        }
    }

    /* ================================
        LARGE DESKTOP (≥1150px) → 6 ITEMS
    ================================= */
    @media screen and (min-width: 1150px) {
        #shopify-section-{{ section.id }} {
        --product-list-items-per-row: 6;
        }
    }

    /* ================================
        OPTIONAL: PRODUCT CARD CLEANUP
    ================================= */
    .product-card__figure {
        position: relative;
    }

    .product-card__media {
        display: grid;
        justify-content: center;
    }

    .product-card {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 1.25rem;
        position: relative;
        align-content: start;
        scroll-snap-align: start;
    }

    .product-card__info {
        display: grid;
        gap: 0.75rem;
        text-align: center;
        justify-items: center;
        align-content: start;
    }

    .product_title{
        text-decoration: none;
        font-weight: 400;
        font-size: 16px;
        letter-spacing: 0.13em;
        font-family: Montserrat, sans-serif;
        text-transform: uppercase;
    }

    .v-stack {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        align-content: start;
    }

    .gap-1 { gap: 0.25rem; }
    .gap-2 { gap: 0.5rem; }

    .justify-items-center {
        justify-items: center;
    }
    .product-list {
        display: grid;
        align-items: start;
        row-gap: clamp(2rem, 3vw, 3rem);
        column-gap: clamp(1rem, 2vw, 3rem);
        grid-template-columns: repeat(6, minmax(0, 1fr));
    }
    </style>

  <div class="section-spacing color-scheme color-scheme--scheme-2">
    <div class="container">

      <div class="section-stack">

        <!-- Heading -->
        <div class="v-stack justify-self-center gap-4 text-center sm:gap-5">
          <p class="h6 text-center">
            {{ section.settings.subheading }}
          </p>

          <h2 class="h2">
            {{ collection.title }}
          </h2>
        </div>

        <!-- Product Grid -->
          <product-list class="product-list justify-center">

            {% for product in collection.products limit: section.settings.limit %}
              <product-card class="product-card">

                <div class="product-card__figure">
                  <a href="{{ product.url }}" class="product-card__media">

                    {% if product.featured_image %}
                      <img
                        src="{{ product.featured_image | image_url: width: 600 }}"
                        alt="{{ product.title }}"
                        class="product-card__image"
                        loading="lazy"
                        width="169"
                        height="169"
                      >
                    {% else %}
                      {{ 'product-1' | placeholder_svg_tag }}
                    {% endif %}

                  </a>
                </div>

                <div class="product-card__info empty:hidden">

                  <div class="v-stack justify-items-center gap-1">

                    <a href="{{ product.url }}" class="product-title h6">
                      {{ product.title }}
                    </a>

                    <price-list class="price-list">
                      <sale-price class="h6 text-subdued">
                        {{ product.price | money }}
                      </sale-price>
                    </price-list>

                  </div>

                </div>

              </product-card>
            {% endfor %}

          </product-list>

          <!-- View All Button -->
          <div class="justify-self-center">
            <a class="button" href="{{ collection.url }}">
              {{ section.settings.button_text }}
            </a>
          </div>

      </div>

    </div>
  </div>

</section>

{% endif %}

{% schema %}
{
  "name": "Featured Collection (QG)",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Select collection"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Featured collection"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "View all"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products to show",
      "min": 6,
      "max": 24,
      "step": 6,
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "Featured Collection (Dynamic)"
    }
  ]
}
{% endschema %}
