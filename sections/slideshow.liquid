{{ 'section-image-banner.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'component-slideshow.css' | asset_url | stylesheet_tag }}

<style>
  #shopify-section-{{ section.id }} .aaaaaa{
    margin-bottom: -44px !important;
  }
  #shopify-section-{{ section.id }} .slideshow-component-q {
    position: relative;
  }
  #shopify-section-{{ section.id }} .slideshow-component-q.is-full-screen,
  #shopify-section-{{ section.id }} .slideshow-component-q.is-full-screen .slideshow {
    min-height: 100svh;
  }
  #shopify-section-{{ section.id }} .slideshow-component-q.is-full-screen .slideshow__slide,
  #shopify-section-{{ section.id }} .slideshow-component-q.is-full-screen .banner__content,
  #shopify-section-{{ section.id }} .slideshow-component-q.is-full-screen .banner__media,
  #shopify-section-{{ section.id }} .slideshow-component-q.is-full-screen .media {
    min-height: 100svh;
  }
  #shopify-section-{{ section.id }} .slideshow-component-q.is-full-screen .slideshow__media {
    background: rgb(var(--color-background));
  }
  #shopify-section-{{ section.id }} .slideshow-component-q.is-full-screen .slideshow__media > img,
  #shopify-section-{{ section.id }} .slideshow-component-q.is-full-screen .slideshow__media > svg {
    height: 100%;
    object-fit: contain;
    object-position: center;
    width: 100%;
  }
  #shopify-section-{{ section.id }} .slideshow__image--mobile {
    display: none;
  }
  #shopify-section-{{ section.id }} .slider-button-q{
    color: #ffffff !important;
    opacity: unset;
    background: none !important;
    border: solid 1px;
  }
  #shopify-section-{{ section.id }} .slider-button-q:after {
    --border-opacity: 0;
    box-shadow: none !important;
  }
  #shopify-section-{{ section.id }} .slideshow__text.banner__box {
    max-width: 66.5rem;
  }
  #shopify-section-{{ section.id }} .slideshow__text .banner__heading {
    font-size: var(--slide-heading-size-mobile, calc(var(--font-heading-scale) * 3rem));
  }
  #shopify-section-{{ section.id }} .slider-txt {
      font-size: 2rem;
  }
  #shopify-section-{{ section.id }} .btn-rowq{
    justify-content: flex-end !important;
    border: none;
    position: relative;
    top: -45px;
  }
  #shopify-section-{{ section.id }} .slideshow-scroll-button {
    align-items: center;
    background: #000000ff;
    border: 0.1rem solid rgba(var(--color-foreground), 0.18);
    border-radius: 999px;
    bottom: 3rem;
    box-shadow: 0 1rem 3rem rgba(var(--color-shadow), 0.14);
    color: #ffffffff;
    cursor: pointer;
    display: inline-flex;
    height: 5.2rem;
    justify-content: center;
    left: 50%;
    padding: 0;
    position: absolute;
    transform: translateX(-50%) translateY(10px);
    transition: transform var(--duration-default) ease, background-color var(--duration-default) ease;
    width: 5.2rem;
    z-index: 3;
  }
  #shopify-section-{{ section.id }} .slideshow-scroll-button:hover {
    background: white !important;
    transform: translateX(-50%) translateY(0.4rem);
    color: black !important;
  }
  #shopify-section-{{ section.id }} .slider-button-q:hover {
    background: white !important;
    color: black !important;
    transition: box-shadow .1s ease, color .3s ease, background-size .4s ease;
  }
  #shopify-section-{{ section.id }} .slideshow-scroll-button .icon-arrow {
    height: 1.4rem;
    transform: rotate(90deg);
    width: 1.8rem;
  }
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .aaaaaa {
      margin-bottom: 0 !important;
    }

    #shopify-section-{{ section.id }} .slideshow-component-q {
      overflow: hidden;
    }

    #shopify-section-{{ section.id }} .slideshow__slide {
      position: relative;
    }

    #shopify-section-{{ section.id }} .slideshow__text-wrapper.banner__content {
      bottom: 0;
      align-items: flex-end;
      display: flex;
      inset: 0;
      padding: 2rem 1.6rem 8.4rem;
      position: absolute;
      top: auto;
      z-index: 2;
    }

    #shopify-section-{{ section.id }} .slideshow__text.banner__box {
      max-width: 100%;
      padding: 2rem 1.6rem;
      margin-inline: auto;
      width: min(100%, 34rem);
    }

    #shopify-section-{{ section.id }} .slideshow__text .banner__heading {
      line-height: 1.02;
      overflow-wrap: anywhere;
    }

    #shopify-section-{{ section.id }} .slider-txt {
      font-size: 1.2rem;
      letter-spacing: 0.14em;
    }

    #shopify-section-{{ section.id }} .btn-rowq {
      justify-content: center !important;
      top: 0;
      margin-top: 1.2rem;
      display: none;
    }

    #shopify-section-{{ section.id }} .slideshow-component-q.is-full-screen,
    #shopify-section-{{ section.id }} .slideshow-component-q.is-full-screen .slideshow,
    #shopify-section-{{ section.id }} .slideshow-component-q.is-full-screen .slideshow__slide,
    #shopify-section-{{ section.id }} .slideshow-component-q.is-full-screen .banner__content,
    #shopify-section-{{ section.id }} .slideshow-component-q.is-full-screen .banner__media,
    #shopify-section-{{ section.id }} .slideshow-component-q.is-full-screen .media {
      min-height: 100svh;
    }

    #shopify-section-{{ section.id }} .slideshow-component-q.is-full-screen .slideshow__media {
      background: transparent;
    }

    #shopify-section-{{ section.id }} .slideshow-component-q.is-full-screen .slideshow__media > img,
    #shopify-section-{{ section.id }} .slideshow-component-q.is-full-screen .slideshow__media > svg {
      object-fit: cover;
    }

    #shopify-section-{{ section.id }} .slideshow__image--desktop.has-mobile-image {
      display: none;
    }

    #shopify-section-{{ section.id }} .slideshow__image--mobile {
      display: block;
    }

    #shopify-section-{{ section.id }} .banner__buttons {
      display: flex;
      max-width: 155px;
      width: 100%;
    }

    #shopify-section-{{ section.id }} .banner__buttons .button {
      width: 100%;
    }

    #shopify-section-{{ section.id }} .slideshow-scroll-button {
      bottom: 1rem;
      height: 3.5rem;
      width: 3.5rem;
    }
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    #shopify-section-{{ section.id }} .slideshow__text.banner__box {
      max-width: 52rem;
    }
  }

  @media only screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .slideshow__text .banner__heading {
      font-size: var(--slide-heading-size-desktop, calc(var(--font-heading-scale) * 4rem));
    }
  }
</style>

{%- if section.settings.slide_height == 'adapt_image' and section.blocks.first.settings.image != blank -%}
  {%- style -%}
    @media screen and (max-width: 749px) {
      #Slider-{{ section.id }}::before,
      #Slider-{{ section.id }} .media::before,
      #Slider-{{ section.id }}:not(.banner--mobile-bottom) .banner__content::before {
        padding-bottom: {{ 1 | divided_by: section.blocks.first.settings.image.aspect_ratio | times: 100 }}%;
        content: '';
        display: block;
      }
    }

    @media screen and (min-width: 750px) {
      #Slider-{{ section.id }}::before,
      #Slider-{{ section.id }} .media::before {
        padding-bottom: {{ 1 | divided_by: section.blocks.first.settings.image.aspect_ratio | times: 100 }}%;
        content: '';
        display: block;
      }
    }
  {%- endstyle -%}
{%- endif -%}

<slideshow-component
  class="aaaaaa slideshow-component-q{% if section.settings.full_screen_hero %} is-full-screen{% endif %} slider-mobile-gutter{% if section.settings.layout == 'grid' %} page-width{% endif %}{% if section.settings.show_text_below %} mobile-text-below{% endif %}"
  role="region"
  aria-roledescription="{{ 'sections.slideshow.carousel' | t }}"
  aria-label="{{ section.settings.accessibility_info | escape }}"
>
  {%- if section.settings.auto_rotate and section.blocks.size > 1 -%}
    <div class="btn-rowq slideshow__controls slideshow__controls--top slider-buttons{% if section.settings.show_text_below %} slideshow__controls--border-radius-mobile{% endif %}">
      <button
        type="button"
        class="hidden slider-button slider-button--prev"
        name="previous"
        aria-label="{{ 'sections.slideshow.previous_slideshow' | t }}"
        aria-controls="Slider-{{ section.id }}"
      >
        <span class="svg-wrapper">
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </span>
      </button>
      <div class="slider-counter slider-counter--{{ section.settings.slider_visual }}{% if section.settings.slider_visual == 'counter' or section.settings.slider_visual == 'numbers' %} caption{% endif %}">
        {%- if section.settings.slider_visual == 'counter' -%}
          <span class="slider-counter--current">1</span>
          <span aria-hidden="true"> / </span>
          <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
          <span class="slider-counter--total">{{ section.blocks.size }}</span>
        {%- else -%}
          <div class="slideshow__control-wrapper">
            {%- for block in section.blocks -%}
              <button
                class="slider-counter__link slider-counter__link--{{ section.settings.slider_visual }} link"
                aria-label="{{ 'sections.slideshow.load_slide' | t }} {{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
                aria-controls="Slider-{{ section.id }}"
              >
                {%- if section.settings.slider_visual == 'numbers' -%}
                  {{ forloop.index -}}
                {%- else -%}
                  <span class="dot"></span>
                {%- endif -%}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
      <button
        type="button"
        class="hidden slider-button slider-button--next"
        name="next"
        aria-label="{{ 'sections.slideshow.next_slideshow' | t }}"
        aria-controls="Slider-{{ section.id }}"
      >
        <span class="svg-wrapper">
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </span>
      </button>

      {%- if section.settings.auto_rotate -%}
        <button
          type="button"
          class="slideshow__autoplay slider-button{% if section.settings.auto_rotate == false %} slideshow__autoplay--paused{% endif %}"
          aria-label="{{ 'sections.slideshow.pause_slideshow' | t }}"
        >
          <span class="svg-wrapper">
            {{- 'icon-pause.svg' | inline_asset_content -}}
          </span>
          <span class="svg-wrapper">
            {{- 'icon-play.svg' | inline_asset_content -}}
          </span>
        </button>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div
    class="slideshow banner banner--{{ section.settings.slide_height }}{% if section.settings.full_screen_hero %} slideshow--full-screen{% endif %} grid grid--1-col slider slider--everywhere{% if section.settings.show_text_below %} banner--mobile-bottom{% endif %}{% if section.blocks.first.settings.image == blank %} slideshow--placeholder{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
    id="Slider-{{ section.id }}"
    aria-live="polite"
    aria-atomic="true"
    data-autoplay="{{ section.settings.auto_rotate }}"
    data-speed="{{ section.settings.change_slides_speed }}"
  >
    {%- for block in section.blocks -%}
      <style>
        #Slide-{{ section.id }}-{{ forloop.index }} .banner__media::after {
          opacity: {{ block.settings.image_overlay_opacity | divided_by: 100.0 }};
        }
      </style>
      <div
        class="slideshow__slide grid__item grid--1-col slider__slide"
        id="Slide-{{ section.id }}-{{ forloop.index }}"
        {{ block.shopify_attributes }}
        role="group"
        aria-roledescription="{{ 'sections.slideshow.slide' | t }}"
        aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
        tabindex="-1"
      >
        <div class="slideshow__media banner__media media{% if block.settings.image == blank and block.settings.mobile_image == blank %} placeholder{% endif %}{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}">
          {%- if block.settings.image or block.settings.mobile_image -%}
            {%- liquid
              assign desktop_image = block.settings.image
              assign mobile_image = block.settings.mobile_image | default: block.settings.image
              assign desktop_image_class = 'slideshow__image--desktop'
              if block.settings.mobile_image != blank
                assign desktop_image_class = 'slideshow__image--desktop has-mobile-image'
              endif
              assign desktop_height = desktop_image.width | divided_by: desktop_image.aspect_ratio | round
              assign mobile_height = mobile_image.width | divided_by: mobile_image.aspect_ratio | round

              if section.settings.image_behavior == 'ambient'
                assign desktop_sizes = '120vw'
                assign desktop_widths = '450, 660, 900, 1320, 1800, 2136, 2400, 3600, 7680'
              else
                assign desktop_sizes = '100vw'
                assign desktop_widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
              endif

              assign mobile_sizes = '100vw'
              assign mobile_widths = '375, 550, 750, 1100, 1500, 1780, 2000'
              assign fetch_priority = 'auto'
              if section.index == 1
                assign fetch_priority = 'high'
              endif
            -%}
            {%- if desktop_image -%}
              {%- if forloop.first %}
                {{
                  desktop_image
                  | image_url: width: 3840
                  | image_tag:
                    class: desktop_image_class,
                    height: desktop_height,
                    sizes: desktop_sizes,
                    widths: desktop_widths,
                    fetchpriority: fetch_priority
                }}
              {%- else -%}
                {{
                  desktop_image
                  | image_url: width: 3840
                  | image_tag:
                    class: desktop_image_class,
                    loading: 'lazy',
                    height: desktop_height,
                    sizes: desktop_sizes,
                    widths: desktop_widths
                }}
              {%- endif -%}
            {%- endif -%}

            {%- if block.settings.mobile_image != blank -%}
              {%- if forloop.first -%}
                {{
                  block.settings.mobile_image
                  | image_url: width: 2000
                  | image_tag:
                    class: 'slideshow__image--mobile',
                    height: mobile_height,
                    sizes: mobile_sizes,
                    widths: mobile_widths,
                    fetchpriority: fetch_priority
                }}
              {%- else -%}
                {{
                  block.settings.mobile_image
                  | image_url: width: 2000
                  | image_tag:
                    class: 'slideshow__image--mobile',
                    loading: 'lazy',
                    height: mobile_height,
                    sizes: mobile_sizes,
                    widths: mobile_widths
                }}
              {%- endif -%}
            {%- endif -%}
          {%- else -%}
            {%- assign placeholder_slide = forloop.index | modulo: 2 -%}
            {%- if placeholder_slide == 1 -%}
              {{ 'hero-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- else -%}
              {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          {%- endif -%}
        </div>
        <div class="slideshow__text-wrapper banner__content banner__content--{{ block.settings.box_align }} page-width{% if block.settings.show_text_box == false %} banner--desktop-transparent{% endif %}{% if settings.animations_reveal_on_scroll and forloop.index == 1 %} scroll-trigger animate--slide-in{% endif %}">
          <div class="slideshow__text banner__box content-container content-container--full-width-mobile color-{{ block.settings.color_scheme }} gradient slideshow__text--{{ block.settings.text_alignment }} slideshow__text-mobile--{{ block.settings.text_alignment_mobile }}">
            {%- if block.settings.subheading != blank -%}
              <div class="banner__text rte slider-txt">
                <p>{{ block.settings.subheading }}</p>
              </div>
            {%- endif -%}
            {%- if block.settings.heading != blank -%}
              {%- liquid
                assign slide_heading_size_mobile = 'calc(var(--font-heading-scale) * 3rem)'
                assign slide_heading_size_desktop = 'calc(var(--font-heading-scale) * 4rem)'

                case block.settings.heading_size
                  when 'h2'
                    assign slide_heading_size_mobile = 'calc(var(--font-heading-scale) * 2rem)'
                    assign slide_heading_size_desktop = 'calc(var(--font-heading-scale) * 2.4rem)'
                  when 'h1'
                    assign slide_heading_size_mobile = 'calc(var(--font-heading-scale) * 3rem)'
                    assign slide_heading_size_desktop = 'calc(var(--font-heading-scale) * 4rem)'
                  when 'h0'
                    assign slide_heading_size_mobile = 'calc(var(--font-heading-scale) * 4rem)'
                    assign slide_heading_size_desktop = 'calc(var(--font-heading-scale) * 5.2rem)'
                  when 'hxl'
                    assign slide_heading_size_mobile = 'calc(var(--font-heading-scale) * 5rem)'
                    assign slide_heading_size_desktop = 'calc(var(--font-heading-scale) * 6.2rem)'
                  when 'hxxl'
                    assign slide_heading_size_mobile = 'clamp(calc(var(--font-heading-scale) * 5.6rem), 14vw, calc(var(--font-heading-scale) * 7.2rem))'
                    assign slide_heading_size_desktop = 'clamp(calc(var(--font-heading-scale) * 5.6rem), 14vw, calc(var(--font-heading-scale) * 7.2rem))'
                endcase
              -%}
              <h2 class="banner__heading inline-richtext {{ block.settings.heading_size }}" style="--slide-heading-size-mobile: {{ slide_heading_size_mobile }}; --slide-heading-size-desktop: {{ slide_heading_size_desktop }};">
                {{ block.settings.heading }}
              </h2>
            {%- endif -%}
            {%- if block.settings.button_label != blank -%}
              <div class="banner__buttons">
                <a
                  {% if block.settings.link %}
                    href="{{ block.settings.link }}"
                  {% else %}
                    role="link" aria-disabled="true"
                  {% endif %}
                  class="button slider-button-q {% if block.settings.button_style_secondary %}button--secondary{% else %}button--primary{% endif %}"
                >
                  {{- block.settings.button_label | escape -}}
                </a>
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- if section.blocks.size > 1 and section.settings.auto_rotate == false -%}
    <div class="slideshow__controls slider-buttons{% if section.settings.show_text_below %} slideshow__controls--border-radius-mobile{% endif %}">
      <button
        type="button"
        class="hidden slider-button slider-button--prev"
        name="previous"
        aria-label="{{ 'sections.slideshow.previous_slideshow' | t }}"
        aria-controls="Slider-{{ section.id }}"
      >
        <span class="svg-wrapper">
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </span>
      </button>
      <div class="slider-counter slider-counter--{{ section.settings.slider_visual }}{% if section.settings.slider_visual == 'counter' or section.settings.slider_visual == 'numbers' %} caption{% endif %}">
        {%- if section.settings.slider_visual == 'counter' -%}
          <span class="slider-counter--current">1</span>
          <span aria-hidden="true"> / </span>
          <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
          <span class="slider-counter--total">{{ section.blocks.size }}</span>
        {%- else -%}
          <div class="slideshow__control-wrapper">
            {%- for block in section.blocks -%}
              <button
                class="slider-counter__link slider-counter__link--{{ section.settings.slider_visual }} link"
                aria-label="{{ 'sections.slideshow.load_slide' | t }} {{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
                aria-controls="Slider-{{ section.id }}"
              >
                {%- if section.settings.slider_visual == 'numbers' -%}
                  {{ forloop.index -}}
                {%- else -%}
                  <span class="dot"></span>
                {%- endif -%}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
      <button
        type="button"
        class="hidden slider-button slider-button--next"
        name="next"
        aria-label="{{ 'sections.slideshow.next_slideshow' | t }}"
        aria-controls="Slider-{{ section.id }}"
      >
        <span class="svg-wrapper">
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </span>
      </button>

      {%- if section.settings.auto_rotate -%}
        <button
          type="button"
          class="slideshow__autoplay slider-button{% if section.settings.auto_rotate == false %} slideshow__autoplay--paused{% endif %}"
          aria-label="{{ 'sections.slideshow.pause_slideshow' | t }}"
        >
          <span class="svg-wrapper">
            {{- 'icon-pause.svg' | inline_asset_content -}}
          </span>
          <span class="svg-wrapper">
            {{- 'icon-play.svg' | inline_asset_content -}}
          </span>
        </button>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if section.settings.show_scroll_button -%}
    <button type="button" class="slideshow-scroll-button" data-slideshow-scroll aria-label="Scroll to next section">
      <span class="svg-wrapper">
        {{- 'icon-arrow.svg' | inline_asset_content -}}
      </span>
    </button>
  {%- endif -%}
</slideshow-component>

{%- if request.design_mode -%}
  <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% javascript %}
  if (!window.__padlifeSlideshowScrollBound) {
    window.__padlifeSlideshowScrollBound = true;

    document.addEventListener('click', (event) => {
      const trigger = event.target.closest('[data-slideshow-scroll]');
      if (!trigger) return;

      const currentSection = trigger.closest('.shopify-section') || trigger.closest('section');
      let nextSection = currentSection ? currentSection.nextElementSibling : null;

      while (nextSection && !nextSection.matches('.shopify-section, section')) {
        nextSection = nextSection.nextElementSibling;
      }

      const header = document.querySelector('.section-header');
      const headerOffset = header ? header.offsetHeight : 0;

      if (nextSection) {
        const top = nextSection.getBoundingClientRect().top + window.scrollY - headerOffset + 24;
        window.scrollTo({ top, behavior: 'smooth' });
        return;
      }

      window.scrollBy({ top: Math.round(window.innerHeight * 0.85), behavior: 'smooth' });
    });
  }
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.slideshow.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "options": [
        {
          "value": "full_bleed",
          "label": "t:sections.slideshow.settings.layout.options__1.label"
        },
        {
          "value": "grid",
          "label": "t:sections.slideshow.settings.layout.options__2.label"
        }
      ],
      "default": "full_bleed",
      "label": "t:sections.slideshow.settings.layout.label"
    },
    {
      "type": "select",
      "id": "slide_height",
      "options": [
        {
          "value": "adapt_image",
          "label": "t:sections.slideshow.settings.slide_height.options__1.label"
        },
        {
          "value": "small",
          "label": "t:sections.slideshow.settings.slide_height.options__2.label"
        },
        {
          "value": "medium",
          "label": "t:sections.slideshow.settings.slide_height.options__3.label"
        },
        {
          "value": "large",
          "label": "t:sections.slideshow.settings.slide_height.options__4.label"
        }
      ],
      "default": "medium",
      "label": "t:sections.slideshow.settings.slide_height.label"
    },
    {
      "type": "checkbox",
      "id": "full_screen_hero",
      "label": "Full screen hero",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_scroll_button",
      "label": "Show scroll down button",
