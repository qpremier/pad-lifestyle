{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{% if section.settings.image_shape == 'blob' %}
  {{ 'mask-blobs.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- unless section.settings.quick_add == 'none' -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
{%- endunless -%}

{%- if section.settings.quick_add == 'standard' -%}
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- if section.settings.quick_add == 'bulk' -%}
  <script src="{{ 'quick-add-bulk.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quick-order-list.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- style -%}

  @media screen and (min-width: 750px) {
      .facets-vertical-sort {
          margin-right: 15px;
      }
  }
  
  @media screen and (max-width: 750px) {
    .section-template--27147866243435__product-grid-padding {
      padding: 0px 10px;
    }
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  .section-{{ section.id }}-padding .card__image-quick-add {
    opacity: 0;
    pointer-events: none;
    transform: translateY(0.6rem);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .section-{{ section.id }}-padding .card__inner:hover .card__image-quick-add,
  .section-{{ section.id }}-padding .card-wrapper:focus-within .card__image-quick-add {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .collection-toolbar-{{ section.id }} {
    align-items: stretch;
    border: 0.1rem solid rgba(var(--color-foreground), 0.08);
    display: grid;
    gap: 0;
    grid-template-columns: minmax(0, 0.2fr) minmax(19rem, 1fr) minmax(19rem, 0.2fr);
    margin-bottom: 2.4rem;
  }

  .collection-toolbar-{{ section.id }}__box {
    align-items: center;
    background: rgb(var(--color-background));
    display: flex;
    min-height: 5.5rem;
    padding: 0;
  }

  .collection-toolbar-{{ section.id }}__box + .collection-toolbar-{{ section.id }}__box {
    border-left: 0.1rem solid rgba(var(--color-foreground), 0.08);
  }

  .collection-toolbar-{{ section.id }}__layout-box {
    justify-content: flex-start;
  }

  .collection-toolbar-{{ section.id }}__layout-buttons {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 61px));
    width: 100%;
  }

  .collection-toolbar-{{ section.id }}__layout-button {
    align-items: center;
    appearance: none;
    background: transparent;
    border: 0;
    /* color: rgb(var(--color-foreground)); */
    color: rgb(18 18 18 / 42%);
    cursor: pointer;
    display: inline-flex;
    font-size: 1.2rem;
    height: 5.5rem;
    min-width: 3.5rem !important;
    justify-content: center;
    letter-spacing: 0.13em;
    padding: 0 1.2rem;
    text-transform: uppercase;
    transition: background-color var(--duration-default) ease, color var(--duration-default) ease;
    width: 100%;
  }

  .collection-toolbar-{{ section.id }}__layout-button + .collection-toolbar-{{ section.id }}__layout-button {
    border-left: 0.1rem solid rgba(var(--color-foreground), 0.08);
  }

  .collection-toolbar-{{ section.id }}__layout-button.is-active {
    color: rgb(var(--color-foreground));
    background: rgb(var(--color-background));

    /* background: rgb(243 243 243);
    color: rgb(18 18 18); */
  }

  .collection-toolbar-{{ section.id }}__count-box {
    justify-content: center;
    padding: 0 1.6rem;
  }

  .collection-toolbar-{{ section.id }}__products-count {
    font-size: 2rem;
    letter-spacing: 0.13em;
    margin: 0;
    text-align: center;
    text-transform: uppercase;
    width: 100%;
  }

  .collection-toolbar-{{ section.id }}__sort-box {
    position: relative;
  }

  .collection-toolbar-{{ section.id }}__sort-form {
    height: 100%;
    margin: 0;
    width: 100%;
  }

  .collection-toolbar-{{ section.id }}__sort-popover {
    height: 100%;
    position: relative;
    width: 100%;
  }

  .collection-toolbar-{{ section.id }}__sort-button {
    align-items: center;
    appearance: none;
    background: transparent;
    border: 0;
    color: rgb(var(--color-foreground));
    cursor: pointer;
    display: flex;
    font-size: 1.2rem;
    height: 5.5rem;
    justify-content: center;
    letter-spacing: 0.13em;
    list-style: none;
    padding: 0 1.8rem;
    text-transform: uppercase;
    width: 100%;
  }

  .collection-toolbar-{{ section.id }}__sort-button::-webkit-details-marker {
    display: none;
  }

  .collection-toolbar-{{ section.id }}__sort-button-text {
    align-items: center;
    display: inline-flex;
    gap: 0.8rem;
    justify-content: center;
  }

  .collection-toolbar-{{ section.id }}__sort-icon {
    display: inline-flex;
    height: 1rem;
    width: 1rem;
  }

  .collection-toolbar-{{ section.id }}__sort-icon .icon-caret {
    position: static;
    transform: rotate(0deg);
    width: 1rem;
  }

  .collection-toolbar-{{ section.id }}__sort-popover.is-open .collection-toolbar-{{ section.id }}__sort-icon .icon-caret {
    transform: rotate(180deg);
  }

  .collection-toolbar-{{ section.id }}__sort-panel {
    background: rgb(var(--color-background));
    border: 0.1rem solid rgba(var(--color-foreground), 0.12);
    box-shadow: 0 1rem 2.4rem rgba(var(--color-shadow), 0.16);
    min-width: 20rem;
    padding: 0.8rem 0;
    position: absolute;
    right: 0;
    top: calc(100% + 0.8rem);
    z-index: 40;
  }

  .collection-toolbar-{{ section.id }}__sort-options {
    border: 0;
    margin: 0;
    padding: 0;
  }

  .collection-toolbar-{{ section.id }}__sort-option {
    align-items: center;
    color: rgb(var(--color-foreground));
    cursor: pointer;
    display: flex;
    font-size: 1.4rem;
    line-height: 1.4;
    min-height: 4.4rem;
    padding: 1.1rem 2rem;
  }

  .collection-toolbar-{{ section.id }}__sort-option:hover span,
  .collection-toolbar-{{ section.id }}__sort-option.is-selected span {
    text-decoration: underline;
    text-underline-offset: 0.3rem;
  }

  .collection-toolbar-{{ section.id }}__sort-option input {
    clip: rect(0 0 0 0);
    height: 1px;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
    position: absolute;
    white-space: nowrap;
    width: 1px;
  }

  .collection-toolbar-{{ section.id }}__sort-option input:focus-visible + span {
    outline: 0.2rem solid rgba(var(--color-foreground), 0.5);
    outline-offset: 0.3rem;
  }

  .section-{{ section.id }}-padding .facets-wrapper .facet-filters.sorting,
  .section-{{ section.id }}-padding .facets-wrapper .product-count,
  .section-{{ section.id }}-padding .facets-wrapper .product-count-vertical,
  .section-{{ section.id }}-padding .facets-vertical-sort {
    display: none !important;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .collection-toolbar-{{ section.id }} {
      grid-template-columns: 1fr;
      margin-bottom: 1.6rem;
    }

    .collection-toolbar-{{ section.id }}__box + .collection-toolbar-{{ section.id }}__box {
      border-left: 0;
      border-top: 0.1rem solid rgba(var(--color-foreground), 0.08);
    }

    .collection-toolbar-{{ section.id }}__layout-button,
    .collection-toolbar-{{ section.id }}__sort-button {
      font-size: 1.1rem;
    }

    .collection-toolbar-{{ section.id }}__sort-box {
      display: none;
    }

    .collection-toolbar-{{ section.id }}__products-count {
      white-space: normal;
    }
  }

  .black-color-line{
    color: #2d2d2d;
  }
{%- endstyle -%}

<div class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}">
  {%- paginate collection.products by section.settings.products_per_page -%}
    {%- liquid
      assign toolbar_sort_by = collection.sort_by | default: collection.default_sort_by
    -%}

    <div class="page-width">
      <div class="collection-toolbar-{{ section.id }}">
        <div class="collection-toolbar-{{ section.id }}__box collection-toolbar-{{ section.id }}__layout-box">
          <div class="collection-toolbar-{{ section.id }}__layout-buttons" role="group" aria-label="Collection layout">
            {%- for columns in (2..4) -%}
              <button
                type="button"
                class="collection-toolbar-{{ section.id }}__layout-button{% if section.settings.columns_desktop == columns %} is-active{% endif %}"
                data-collection-layout
                data-columns="{{ columns }}"
                aria-pressed="{% if section.settings.columns_desktop == columns %}true{% else %}false{% endif %}"
                aria-label="Show {{ columns }} products per row"
              >
                {%- case columns -%}
                  {%- when 2 -%}
                    <svg role="presentation" width="18" viewBox="0 0 18 18" fill="none">
                      <path fill="currentColor" d="M0 0h8v8H0zM0 10h8v8H0zM10 0h8v8h-8zM10 10h8v8h-8z"></path>
                    </svg>
                  {%- when 3 -%}
                    <svg role="presentation" width="18" viewBox="0 0 18 18" fill="none">
                      <path fill="currentColor" d="M0 0h4v4H0zM0 7h4v4H0zM0 14h4v4H0zM7 0h4v4H7zM7 7h4v4H7zM7 14h4v4H7zM14 0h4v4h-4zM14 7h4v4h-4zM14 14h4v4h-4z"></path>
                    </svg>
                  {%- when 4 -%}
                    <svg role="presentation" width="18" viewBox="0 0 18 18" fill="none">
                      <path fill="currentColor" d="M0 0h18v2H0zm0 4h18v2H0zm0 4h18v2H0zm0 4h18v2H0zm0 4h18v2H0z"></path>
                    </svg>
                {%- endcase -%}
              </button>
            {%- endfor -%}
          </div>
        </div>

        <div class="collection-toolbar-{{ section.id }}__box collection-toolbar-{{ section.id }}__count-box">
          <p class="collection-toolbar-{{ section.id }}__products-count text-subdued">
            {%- if collection.results_count -%}
              {{ 'templates.search.results_with_count' | t: terms: collection.terms, count: collection.results_count }}
            {%- elsif collection.products_count == collection.all_products_count -%}
              {{ 'products.facets.product_count_simple' | t: count: collection.products_count }}
            {%- else -%}
              {{ 'products.facets.product_count' | t: product_count: collection.products_count, count: collection.all_products_count }}
            {%- endif -%}
          </p>
        </div>

        <div class="collection-toolbar-{{ section.id }}__box collection-toolbar-{{ section.id }}__sort-box">
          {%- if section.settings.enable_sorting -%}
            <div class="collection-toolbar-{{ section.id }}__sort-form">
              <form id="CollectionToolbarSortForm-{{ section.id }}">
                {%- if collection.terms -%}
                  <input type="hidden" name="q" value="{{ collection.terms | escape }}">
                  <input name="options[prefix]" type="hidden" value="last">
                {%- endif -%}

                <div class="collection-toolbar-{{ section.id }}__sort-popover" data-collection-sort-popover>
                  <button
                    type="button"
                    class="collection-toolbar-{{ section.id }}__sort-button heading text-xxs w-full focus-offset"
                    aria-controls="sort-by-popover-{{ section.id }}"
                    aria-haspopup="dialog"
                    aria-expanded="false"
                    data-collection-sort-button
                  >
                    <span class="collection-toolbar-{{ section.id }}__sort-button-text text-with-icon justify-center">
                      {{ 'products.facets.sort_button' | t }}
                      <span class="collection-toolbar-{{ section.id }}__sort-icon svg-wrapper">
                        {{- 'icon-caret.svg' | inline_asset_content -}}
                      </span>
                    </span>
                  </button>
                  <div
                    id="sort-by-popover-{{ section.id }}"
                    class="collection-toolbar-{{ section.id }}__sort-panel gradient"
                    role="dialog"
                    hidden
                  >
                    <fieldset class="collection-toolbar-{{ section.id }}__sort-options">
                      <legend class="visually-hidden">{{ 'products.facets.sort_by_label' | t }}</legend>
                      {%- for option in collection.sort_options -%}
                        <label
                          class="collection-toolbar-{{ section.id }}__sort-option{% if option.value == toolbar_sort_by %} is-selected{% endif %}"
                          for="CollectionToolbarSortBy-{{ section.id }}-{{ forloop.index }}"
                          role="option"
                          aria-selected="{% if option.value == toolbar_sort_by %}true{% else %}false{% endif %}"
                        >
                          <input
                            type="radio"
                            name="sort_by"
                            id="CollectionToolbarSortBy-{{ section.id }}-{{ forloop.index }}"
                            value="{{ option.value | escape }}"
                            {% if option.value == toolbar_sort_by %}
                              checked
                            {% endif %}
                          >
                          <span>{{ option.name | escape }}</span>
                        </label>
                      {%- endfor -%}
                    </fieldset>
                  </div>
                </div>
              </form>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>

    {% comment %} Sort is the first tabbable element when filter type is vertical {% endcomment %}
    {%- if section.settings.enable_sorting and section.settings.filter_type == 'vertical' -%}
      <facet-filters-form class="facets facets-vertical-sort page-width small-hide">
        <form class="facets-vertical-form" id="FacetSortForm">
          <div class="facet-filters sorting caption">
            <div class="facet-filters__field">
              <h2 class="facet-filters__label caption-large text-body">
                <label for="SortBy">{{ 'products.facets.sort_by_label' | t }}</label>
              </h2>
              <div class="select">
                {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
                <select
                  name="sort_by"
                  class="facet-filters__sort select__select caption-large"
                  id="SortBy"
                  aria-describedby="a11y-refresh-page-message"
                >
                  {%- for option in collection.sort_options -%}
                    <option
                      value="{{ option.value | escape }}"
                      {% if option.value == sort_by %}
                        selected="selected"
                      {% endif %}
                    >
                      {{ option.name | escape }}
                    </option>
                  {%- endfor -%}
                </select>
                <span class="svg-wrapper">
                  {{- 'icon-caret.svg' | inline_asset_content -}}
                </span>
              </div>
            </div>
          </div>

          <div class="product-count-vertical light" role="status">
            <h2 class="product-count__text text-body">
              <span id="ProductCountDesktop">
                {%- if collection.results_count -%}
                  {{
                    'templates.search.results_with_count'
                    | t: terms: collection.terms, count: collection.results_count
                  }}
                {%- elsif collection.products_count == collection.all_products_count -%}
                  {{ 'products.facets.product_count_simple' | t: count: collection.products_count }}
                {%- else -%}
                  {{
                    'products.facets.product_count'
                    | t: product_count: collection.products_count, count: collection.all_products_count
                  }}
                {%- endif -%}
              </span>
            </h2>
            {%- render 'loading-spinner' -%}
          </div>
        </form>
      </facet-filters-form>
    {%- endif -%}

    <div class="{% if section.settings.filter_type == 'vertical' %} facets-vertical page-width{% endif %}">
      {{ 'component-facets.css' | asset_url | stylesheet_tag }}
      <script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
      {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
        <aside
          aria-labelledby="verticalTitle"
          class="facets-wrapper collection-mobile-facets-wrapper{% unless section.settings.enable_filtering %} facets-wrapper--no-filters{% endunless %}{% if section.settings.filter_type != 'vertical' %} page-width{% endif %}"
          id="main-collection-filters"
          data-id="{{ section.id }}"
        >
          {% render 'facets',
            results: collection,
            enable_filtering: section.settings.enable_filtering,
            enable_sorting: section.settings.enable_sorting,
            filter_type: section.settings.filter_type,
            paginate: paginate,
            separate_mobile_sort: true
          %}
        </aside>
      {%- endif -%}

      <div
        class="product-grid-container{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
        id="ProductGridContainer"
        {% if settings.animations_reveal_on_scroll %}
          data-cascade
        {% endif %}
      >
        {%- if collection.products.size == 0 -%}
          <div class="collection collection--empty page-width" id="product-grid" data-id="{{ section.id }}">
            <div class="loading-overlay gradient"></div>
            <div class="title-wrapper center">
              <h2 class="title title--primary">
                {{ 'sections.collection_template.empty' | t -}}
                <br>
                {{
                  'sections.collection_template.use_fewer_filters_html'
                  | t: link: collection.url, class: 'underlined-link link black-color-line'
                }}
              </h2>
            </div>
          </div>
        {%- else -%}
          <div
            class="collection{% if section.settings.filter_type != 'vertical' %} page-width{% endif %}"
          >
            <div class="loading-overlay gradient"></div>
            <ul
              id="product-grid"
              data-id="{{ section.id }}"
              class="
                grid product-grid grid--{{ section.settings.columns_mobile }}-col-tablet-down
                grid--{{ section.settings.columns_desktop }}-col-desktop
                {% if section.settings.quick_add == 'bulk' %} collection-quick-add-bulk{% endif %}
              "
            >
              {% assign skip_card_product_styles = false %}
              {%- for product in collection.products -%}
                {% assign lazy_load = false %}
                {%- if forloop.index > 2 -%}
                  {%- assign lazy_load = true -%}
                {%- endif -%}
                <li
                  class="grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                  {% if settings.animations_reveal_on_scroll %}
                    data-cascade
                    style="--animation-order: {{ forloop.index }};"
                  {% endif %}
                >
                  {% render 'card-product',
                    card_product: product,
                    media_aspect_ratio: section.settings.image_ratio,
                    image_shape: section.settings.image_shape,
                    show_secondary_image: section.settings.show_secondary_image,
                    show_vendor: section.settings.show_vendor,
                    show_rating: section.settings.show_rating,
                    lazy_load: lazy_load,
                    skip_styles: skip_card_product_styles,
                    quick_add: section.settings.quick_add,
                    link_image: true,
                    section_id: section.id
                  %}
                </li>
                {%- assign skip_card_product_styles = true -%}
              {%- endfor -%}
            </ul>

            {%- if paginate.pages > 1 -%}
              {% render 'pagination', paginate: paginate, anchor: '' %}
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endpaginate -%}
  {% if section.settings.image_shape == 'arch' %}
    {{ 'mask-arch.svg' | inline_asset_content }}
  {%- endif -%}
</div>

<script>
  function closeCollectionSortPopover(popover) {
    if (!popover) return;

    const button = popover.querySelector('[data-collection-sort-button]');
    const panel = popover.querySelector('[role="dialog"]');

    popover.classList.remove('is-open');
    if (button) button.setAttribute('aria-expanded', 'false');
    if (panel) panel.hidden = true;
  }

  document.addEventListener('click', function(event) {
    const sortButton = event.target.closest('[data-collection-sort-button]');

    if (sortButton && sortButton.closest('.section-{{ section.id }}-padding')) {
      const popover = sortButton.closest('[data-collection-sort-popover]');
      const panel = document.getElementById(sortButton.getAttribute('aria-controls'));
      const isOpen = sortButton.getAttribute('aria-expanded') === 'true';

      popover.classList.toggle('is-open', !isOpen);
      sortButton.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
      if (panel) panel.hidden = isOpen;
      return;
    }

    document
      .querySelectorAll('.section-{{ section.id }}-padding [data-collection-sort-popover].is-open')
      .forEach(function(popover) {
        if (!popover.contains(event.target)) closeCollectionSortPopover(popover);
      });

    const trigger = event.target.closest('[data-collection-layout]');
    if (!trigger || !trigger.closest('.section-{{ section.id }}-padding')) return;

    const sectionRoot = trigger.closest('.section-{{ section.id }}-padding');
    const productGrid = sectionRoot.querySelector('#product-grid');
    if (!productGrid) return;

    const nextColumns = trigger.getAttribute('data-columns');
    if (!nextColumns) return;

    ['2', '3', '4'].forEach(function(columns) {
      productGrid.classList.remove('grid--' + columns + '-col-desktop');
    });

    productGrid.classList.add('grid--' + nextColumns + '-col-desktop');

    sectionRoot.querySelectorAll('[data-collection-layout]').forEach(function(button) {
      const isActive = button === trigger;
      button.classList.toggle('is-active', isActive);
      button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
    });
  });

  document.addEventListener('change', function(event) {
    if (!event.target.matches('.section-{{ section.id }}-padding .collection-toolbar-{{ section.id }} input[name="sort_by"]')) return;

    closeCollectionSortPopover(event.target.closest('[data-collection-sort-popover]'));
    event.target.form.submit();
  });

  document.addEventListener('keyup', function(event) {
    if (event.key !== 'Escape') return;

    document
      .querySelectorAll('.section-{{ section.id }}-padding [data-collection-sort-popover].is-open')
      .forEach(closeCollectionSortPopover);
  });
</script>

{% schema %}
{
  "name": "t:sections.main-collection-product-grid.name",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 16,
      "label": "t:sections.main-collection-product-grid.settings.products_per_page.label"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "t:sections.main-collection-product-grid.settings.columns_desktop.label"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "default": "2",
      "label": "t:sections.main-collection-product-grid.settings.columns_mobile.label",
      "options": [
        {
          "value": "1",
          "label": "t:sections.main-collection-product-grid.settings.columns_mobile.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.main-collection-product-grid.settings.columns_mobile.options__2.label"
        }
      ]
    },    
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "info": "t:sections.all.colors.has_cards_info",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.main-collection-product-grid.settings.header__3.content"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
